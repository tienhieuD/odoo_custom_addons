<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_dwo_model_concurrency_form" model="ir.ui.view">
        <field name="name">view.dwo.model.concurrency.form</field>
        <field name="model">dwo.model.concurrency</field>
        <field name="arch" type="xml">
            <form string="Dwo Model Concurrency">
                <field name="id" invisible="1" />
                <field name="active" invisible="1" />
                <field name="field_domain" invisible="1" />
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active" />
                    <group>
                        <field name="model_id" />
                        <field name="model" />
                    </group>
                    <notebook>
                        <page name="fields" string="Fields">
                            <field name="field_ids" nolabel="1" domain="field_domain" option="{'no_create': True}"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_dwo_model_concurrency_tree" model="ir.ui.view">
        <field name="name">view.dwo.model.concurrency.tree</field>
        <field name="model">dwo.model.concurrency</field>
        <field name="arch" type="xml">
            <tree>
                <field name="model_id" />
            </tree>
        </field>
    </record>

    <record id="view_dwo_model_concurrency_search" model="ir.ui.view">
        <field name="name">view.dwo.model.concurrency.search</field>
        <field name="model">dwo.model.concurrency</field>
        <field name="arch" type="xml">
            <search>
                <field name="model_id" />
            </search>
        </field>
    </record>

    <record id="action_dwo_model_concurrency_views" model="ir.actions.act_window">
        <field name="name">Model Concurrency Configuration</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">dwo.model.concurrency</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[]</field>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="oe_view_nocontent_create">There is no examples click here to add new Dwo Model Concurrency.</p>
        </field>
    </record>
</odoo>