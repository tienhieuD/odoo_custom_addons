<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Hai nhóm quyền SLA (REQ-SEC-001): group_sla_user chỉ đọc,
         group_sla_manager thêm quyền cấu hình/đánh giá lại/tính lại/xử lý
         event lỗi. -->
    <record id="module_category_sla" model="ir.module.category">
        <field name="name">SLA</field>
        <field name="sequence">25</field>
    </record>

    <record id="privilege_sla" model="res.groups.privilege">
        <field name="name">SLA</field>
        <field name="category_id" ref="module_category_sla"/>
    </record>

    <record id="group_sla_user" model="res.groups">
        <field name="name">SLA / Viewer</field>
        <field name="privilege_id" ref="privilege_sla"/>
    </record>

    <record id="group_sla_manager" model="res.groups">
        <field name="name">SLA / Configuration Administrator</field>
        <field name="privilege_id" ref="privilege_sla"/>
        <field name="implied_ids" eval="[(4, ref('group_sla_user'))]"/>
    </record>

    <!-- Quản trị hệ thống mặc định là SLA Manager: group_system kéo theo
         group_sla_manager (và group_sla_user qua implied) nên admin luôn thấy
         menu SLA và dùng được các hành động Tính lại/Đánh giá lại. -->
    <record id="base.group_system" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('group_sla_manager'))]"/>
    </record>

    <!-- Cô lập đa công ty (REQ-SEC-003): định nghĩa không gán công ty áp
         dụng cho mọi công ty; định nghĩa gán công ty chỉ thấy được bởi
         user thuộc công ty đó. Áp dụng tương tự cho task và event (company_id
         sao chép từ record gốc, 020 AD-13). -->
    <record id="rule_sla_definition_company" model="ir.rule">
        <field name="name">sla.definition: company</field>
        <field name="model_id" ref="model_sla_definition"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>

    <record id="rule_sla_task_company" model="ir.rule">
        <field name="name">sla.task: company</field>
        <field name="model_id" ref="model_sla_task"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>

    <record id="rule_sla_event_company" model="ir.rule">
        <field name="name">sla.event: company</field>
        <field name="model_id" ref="model_sla_event"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>

    <!-- Lần apply thủ công theo công ty của định nghĩa (cùng mẫu 3 rule trên). -->
    <record id="rule_sla_apply_job_company" model="ir.rule">
        <field name="name">sla.apply.job: company</field>
        <field name="model_id" ref="model_sla_apply_job"/>
        <field name="domain_force">['|', ('definition_id.company_id', '=', False), ('definition_id.company_id', 'in', company_ids)]</field>
    </record>
</odoo>
