    <record id="action_sla_report_trend" model="ir.actions.act_window">
        <field name="name">Compliance Trend</field>
        <field name="res_model">sla.task</field>
        <field name="view_mode">graph,pivot,tree,form</field>
        <field name="search_view_id" ref="view_sla_task_search"/>
        <field name="domain">[('stage', 'in', ('achieved', 'breached'))]</field>
        <field name="context">{'search_default_last_30': 1}</field>
    </record>
    <record id="action_sla_report_trend_graph" model="ir.actions.act_window.view">
        <field name="sequence">1</field>
        <field name="view_mode">graph</field>
        <field name="view_id" ref="view_sla_report_trend_graph"/>
        <field name="act_window_id" ref="action_sla_report_trend"/>
