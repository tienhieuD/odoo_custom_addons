<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Báo cáo (task 006 C2): menu SLA > Reporting. Mọi màn hình chỉ đọc, dùng
         field lưu của sla.task (outcome, usage_bucket...) và của sla.event;
         group_sla_user đọc được theo ir.model.access có sẵn. Không dùng
         source_name trong view chung (chỉ SLA Manager đọc được). Graph chuẩn
         của Odoo chỉ có MỘT measure, nên so sánh hai measure (R7, R10) dùng
         pivot. -->

    <record id="view_sla_report_trend_graph" model="ir.ui.view">
        <field name="name">sla.task.report.trend.graph</field>
        <field name="model">sla.task</field>
        <field name="arch" type="xml">
            <graph string="Compliance Trend" type="line" stacked="0">
                <field name="end_time" interval="week"/>
                <field name="sla_id"/>
                <field name="achieved_rate" type="measure" widget="percentage"/>
            </graph>
        </field>
    </record>

    <record id="view_sla_report_trend_pivot" model="ir.ui.view">
        <field name="name">sla.task.report.trend.pivot</field>
        <field name="model">sla.task</field>
        <field name="arch" type="xml">
            <pivot string="Compliance Trend" display_quantity="1">
                <field name="sla_id" type="row"/>
                <field name="end_time" interval="week" type="col"/>
                <field name="achieved_rate" type="measure" widget="percentage"/>
            </pivot>
        </field>
    </record>

    <record id="view_sla_report_distribution_graph" model="ir.ui.view">
        <field name="name">sla.task.report.distribution.graph</field>
        <field name="model">sla.task</field>
        <field name="arch" type="xml">
            <graph string="Response Time Distribution" type="bar" stacked="1">
                <field name="sla_id"/>
                <field name="usage_bucket"/>
            </graph>
        </field>
    </record>

    <record id="view_sla_report_distribution_pivot" model="ir.ui.view">
        <field name="name">sla.task.report.distribution.pivot</field>
        <field name="model">sla.task</field>
        <field name="arch" type="xml">
            <pivot string="Response Time Distribution" display_quantity="1">
                <field name="sla_id" type="row"/>
                <field name="usage_bucket" type="col"/>
                <field name="final_percent_used" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="view_sla_report_status_graph" model="ir.ui.view">
        <field name="name">sla.task.report.status.graph</field>
        <field name="model">sla.task</field>
        <field name="arch" type="xml">
            <graph string="Status Mix" type="pie">
                <field name="outcome"/>
            </graph>
        </field>
    </record>

    <record id="view_sla_report_status_pivot" model="ir.ui.view">
        <field name="name">sla.task.report.status.pivot</field>
        <field name="model">sla.task</field>
        <field name="arch" type="xml">
            <pivot string="Status Mix" display_quantity="1">
                <field name="outcome" type="row"/>
                <field name="sla_id" type="col"/>
            </pivot>
        </field>
    </record>

    <record id="view_sla_report_backlog_pivot" model="ir.ui.view">
        <field name="name">sla.task.report.backlog.pivot</field>
        <field name="model">sla.task</field>
        <field name="arch" type="xml">
            <pivot string="Open Backlog &amp; Ageing" display_quantity="1">
                <field name="sla_id" type="row"/>
                <field name="res_model" type="row"/>
                <field name="planned_end_time" interval="week" type="col"/>
                <field name="breaching_count" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="view_sla_report_backlog_list" model="ir.ui.view">
        <field name="name">sla.task.report.backlog.list</field>
        <field name="model">sla.task</field>
        <field name="arch" type="xml">
            <tree string="Open Backlog &amp; Ageing" default_order="planned_end_time asc, id asc"
                  create="0" edit="0" delete="0" decoration-danger="has_breached">
                <field name="sla_id"/>
                <field name="res_model"/>
                <!-- source_name: chỉ SLA Manager đọc được (TC-SEC-017). -->
                <field name="source_name" groups="dwo_sla_core.group_sla_manager"/>
                <field name="stage" widget="badge"
                       decoration-info="stage == 'in_progress'"
                       decoration-warning="stage == 'paused'"/>
                <field name="start_time" optional="hide"/>
                <field name="planned_end_time"/>
                <field name="business_percent_used" string="% Used" widget="progressbar"
                       options="{'overflow_class': 'bg-danger'}"/>
                <field name="has_breached" invisible="1"/>
            </tree>
        </field>
    </record>

    <record id="view_sla_report_performance_graph" model="ir.ui.view">
        <field name="name">sla.task.report.performance.graph</field>
        <field name="model">sla.task</field>
