<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Odoo 14: the assets are declared by inheriting the bundle templates (no `assets` key in the manifest). -->
    <template id="assets_backend" name="SLA &amp; Escalation assets" inherit_id="web.assets_backend">
        <xpath expr="//script[last()]" position="after">
            <script type="text/javascript" src="/dwo_sla_core/static/src/js/sla_legacy.js"/>
            <!-- Odoo 12 has no web.assets_tests bundle: the tours (a few KB) are in the backend bundle -->
            <script type="text/javascript" src="/dwo_sla_core/static/tests/tours/definition_form_tour.js"/>
            <script type="text/javascript" src="/dwo_sla_core/static/tests/tours/form_sla_status_tour.js"/>
            <link rel="stylesheet" type="text/scss" href="/dwo_sla_core/static/src/sla_progress/sla_progress_widget.scss"/>
            <link rel="stylesheet" type="text/scss" href="/dwo_sla_core/static/src/form_sla_status/form_sla_status.scss"/>
        </xpath>
    </template>

</odoo>
