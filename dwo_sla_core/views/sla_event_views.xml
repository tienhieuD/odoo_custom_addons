<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Danh sách event chỉ đọc (REQ-INT-021); không có form sửa/xóa
         (REQ-SEC-006) ngoại trừ hành động "Đánh dấu đã xử lý" và "Đánh
         giá lại" (gọi method, không sửa field trực tiếp qua form). -->
    <record id="view_sla_event_list" model="ir.ui.view">
        <field name="name">sla.event.list</field>
        <field name="model">sla.event</field>
        <field name="arch" type="xml">
            <tree string="SLA Events" default_order="event_dt desc" create="0" delete="0">
                <header>
                    <button name="action_mark_resolved" type="object"
                            string="Mark Resolved"
                            groups="dwo_sla_core.group_sla_manager"/>
                    <!-- Refs: REQ-FUNC-031 -->
                    <button name="action_reevaluate_batch" type="object"
                            string="Re-evaluate"
                            groups="dwo_sla_core.group_sla_manager"
                            help="Check the SLA again for the records linked to the selected error events."/>
                </header>
                <field name="event_dt"/>
                <field name="event" widget="badge"
                       decoration-danger="event in ('error', 'escalate_failed')"/>
                <field name="definition_id"/>
                <field name="res_model"/>
                <field name="note"/>
                <field name="is_resolved" widget="boolean_toggle"/>
            </tree>
        </field>
    </record>

    <record id="view_sla_event_search" model="ir.ui.view">
        <field name="name">sla.event.search</field>
        <field name="model">sla.event</field>
        <field name="arch" type="xml">
            <search string="SLA Events">
                <field name="definition_id"/>
                <field name="res_model"/>
                <field name="event"/>
                <filter string="Error" name="error" domain="[('event', '=', 'error')]"/>
                <filter string="Unresolved Errors" name="error_unresolved"
                        domain="[('event', '=', 'error'), ('is_resolved', '=', False)]"/>
                <filter string="Escalate" name="escalate" domain="[('event', '=', 'escalate')]"/>
                <group>
                    <filter string="Definition" name="group_definition" context="{'group_by': 'definition_id'}"/>
                    <filter string="Event Type" name="group_event" context="{'group_by': 'event'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_sla_event" model="ir.actions.act_window">
        <field name="name">SLA Events</field>
        <field name="res_model">sla.event</field>
        <field name="view_mode">list</field>
    </record>

    <!-- REQ-INT-022: mở sẵn với bộ lọc lỗi chưa xử lý; số lượng hiển thị
         qua pager của danh sách ngay khi mở (ví dụ "1-20 / 3"), không cần
         widget riêng cho action này (2 widget JS của module, sla_progress
         và float_time_unit, Deviation D11, không liên quan tới sla.event). -->
    <record id="action_sla_event_error_unresolved" model="ir.actions.act_window">
        <field name="name">Unresolved Error Events</field>
        <field name="res_model">sla.event</field>
        <field name="view_mode">list</field>
        <field name="domain">[('event', '=', 'error'), ('is_resolved', '=', False)]</field>
        <field name="context">{'search_default_error_unresolved': 1}</field>
    </record>
</odoo>
