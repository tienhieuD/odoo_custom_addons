#. module: dwo_sla_core
#: model:ir.model.fields,field_description:dwo_sla_core.field_sla_definition__message_partner_ids
msgid "Followers (Partners)"
msgstr "フォロワー（パートナー）"

#. module: dwo_sla_core
#: model:ir.model,name:dwo_sla_core.model_ir_http
msgid "HTTP Routing"
msgstr "HTTPルーティング"

#. module: dwo_sla_core
#: model:ir.model.fields,field_description:dwo_sla_core.field_sla_definition__has_message
