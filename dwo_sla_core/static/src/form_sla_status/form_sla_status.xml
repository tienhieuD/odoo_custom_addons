<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="dwo_sla_core.SlaStatusChip">
        <button t-if="summary" type="button"
                class="o_sla_status_chip btn btn-sm ms-2"
                t-att-class="meta.cls"
                data-tooltip-template="dwo_sla_core.SlaStatusChip.Tooltip"
                data-tooltip-position="bottom"
                t-att-data-tooltip-info="tooltipInfo"
                t-on-click.stop="openTasks">
            <i class="fa me-1" t-att-class="meta.icon"/>
            <span class="o_sla_status_label" t-out="label"/>
            <span t-if="hasBar" class="o_sla_status_bar">
                <span class="o_sla_status_bar_fill" t-attf-style="width: #{barWidth}%"/>
            </span>
        </button>
    </t>

    <t t-name="dwo_sla_core.SlaStatusChip.Tooltip">
        <div t-foreach="lines" t-as="line" t-key="line_index" t-out="line"/>
    </t>

    <t t-inherit="web.FormView" t-inherit-mode="extension">
        <xpath expr="//Layout" position="inside">
            <t t-set-slot="control-panel-navigation-additional">
                <t t-if="slaChipVisible" t-component="SlaStatusChip"
                   resModel="props.resModel" resId="model.root.resId"
                   reloadKey="slaChipState.key"/>
            </t>
        </xpath>
    </t>

</templates>
