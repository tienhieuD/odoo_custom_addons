<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="dwo_sla_core.FloatTimeUnitField">
        <span class="o_field_float_time_unit d-inline-flex align-items-baseline">
            <span t-if="this.props.readonly" t-esc="this.formattedValue"/>
            <input t-else="" t-att-id="this.props.id" type="text" t-ref="this.numpadDecimalRef"
                   class="o_input" autocomplete="off"/>
            <span class="text-muted ms-1" t-esc="this.props.unit"/>
        </span>
    </t>

</templates>
