<!-- Odoo 20: templates read the component through this., icons are .oi (Font Awesome is gone), t-out for t-esc -->
<templates xml:space="preserve">
    <t t-name="dwo_attpreview_text.LineView">
        <div class="o_dwo_lines" t-att-class="{ o_dwo_lines_wrap: this.props.wrap, o_dwo_lines_table: this.props.headers }">
            <div t-if="this.props.headers" class="o_dwo_lines_head" t-att-style="this.gridStyle" aria-hidden="true">
                <span t-foreach="this.props.headers" t-as="h" t-key="h_index" t-out="h"/>
            </div>
            <div class="o_dwo_lines_scroll" t-ref="this.scroll" tabindex="0" t-att-aria-label="this.props.label or 'Lines'">
                <div class="o_dwo_lines_list" t-ref="this.list" t-attf-style="height: {{ this.totalHeight }}px;">
                    <div t-foreach="this.rows" t-as="r" t-key="r.index" class="o_dwo_line" t-att-class="r.cls"
                         t-att-data-index="r.index" t-attf-style="transform: translateY({{ r.top }}px); {{ this.gridStyle }}">
                        <t t-foreach="r.cells" t-as="c" t-key="c_index">
                            <span t-if="c.num !== undefined" class="o_dwo_line_num" t-out="c.num"/>
                            <span class="o_dwo_line_text" t-att-class="c.cls" t-out="c.html"/>
                        </t>
                    </div>
                </div>
            </div>
        </div>
    </t>

    <t t-name="dwo_attpreview_text.TextViewer">
        <div class="o_dwo_txt" t-ref="this.root" t-att-data-mode="this.ui.mode" t-att-data-format="this.group">
            <div class="o_dwo_txt_bar">
                <div t-if="this.viewButtons.length > 1" class="btn-group btn-group-sm o_dwo_txt_views" role="tablist" aria-label="View">
                    <button t-foreach="this.viewButtons" t-as="v" t-key="v.id" type="button" role="tab"
                            class="btn o_dwo_txt_view" t-att-class="this.ui.mode === v.id ? 'btn-primary active' : 'btn-outline-secondary'"
                            t-att-aria-selected="this.ui.mode === v.id ? 'true' : 'false'" t-att-data-view="v.id"
                            t-on-click="() => this.setMode(v.id)" t-out="v.label"/>
                </div>
                <span class="o_dwo_txt_info text-muted">
                    <t t-foreach="this.infoParts" t-as="part" t-key="part_index">
                        <span t-if="part_index" class="o_dwo_txt_sep">·</span><span t-out="part"/>
                    </t>
                </span>
                <div class="o_dwo_txt_tools">
                    <t t-if="this.lineMode">
                        <button type="button" class="btn btn-sm btn-light o_dwo_txt_find_btn" title="Find (Ctrl+F)"
                                aria-label="Find" t-on-click="() => this.openFind()"><i class="oi" data-icon="search" aria-hidden="true"/></button>
                    </t>
                    <input t-if="this.views.includes('raw')" type="number" min="1" class="form-control form-control-sm o_dwo_txt_goto"
                           placeholder="Go to line" aria-label="Go to line" title="Go to line (Ctrl+G)" t-on-keydown="(ev) => this.onGotoKeydown(ev)"/>
                    <button t-if="this.lineMode" type="button" class="btn btn-sm o_dwo_txt_wrap"
                            t-att-class="this.ui.wrap ? 'btn-secondary' : 'btn-light'" t-att-aria-pressed="this.ui.wrap ? 'true' : 'false'"
                            title="Wrap long lines" t-on-click="() => this.toggleWrap()"><i class="oi me-1" data-icon="wrap_text" aria-hidden="true"/>Wrap</button>
                    <button type="button" class="btn btn-sm btn-light o_dwo_txt_copy" title="Copy the whole text"
                            t-on-click="() => this.copyAll()"><i class="oi me-1" data-icon="content_copy" aria-hidden="true"/>Copy</button>
                </div>
            </div>

            <div t-if="this.ui.findOpen and this.lineMode" class="o_dwo_txt_findbar">
                <i class="oi text-muted" data-icon="search" aria-hidden="true"/>
                <input type="search" class="form-control form-control-sm o_dwo_txt_find_input" placeholder="Find in the text"
                       aria-label="Find in the text" t-att-value="this.ui.query" t-on-input="(ev) => this.onFindInput(ev)" t-on-keydown="(ev) => this.onFindKeydown(ev)"/>
                <span class="o_dwo_txt_matches text-muted" t-out="this.matchLabel"/>
                <button type="button" class="btn btn-sm btn-light" title="Previous (Shift+Enter)" aria-label="Previous"
                        t-on-click="() => this.nextMatch(-1)"><i class="oi" data-icon="keyboard_arrow_up" aria-hidden="true"/></button>
                <button type="button" class="btn btn-sm btn-light" title="Next (Enter)" aria-label="Next"
                        t-on-click="() => this.nextMatch(1)"><i class="oi" data-icon="keyboard_arrow_down" aria-hidden="true"/></button>
                <button type="button" class="btn btn-sm btn-light" title="Close (Esc)" aria-label="Close find"
                        t-on-click="() => this.closeFind()"><i class="oi" data-icon="close" aria-hidden="true"/></button>
            </div>

            <div t-if="this.data.truncated" class="o_dwo_txt_note alert alert-warning mb-0">
                Large file: only the first 10 MB are shown, without tree. Download the file to see all of it.
            </div>
            <div t-if="this.ui.mode === 'raw' and this.bigNoColours" class="o_dwo_txt_note alert alert-light mb-0 text-muted">
                Large file: shown without syntax colours, so that it stays fast.
            </div>

            <!-- Raw -->
            <t t-if="this.ui.mode === 'raw'">
                <DwoLineView t-key="'raw' + this.ui.wrap" count="this.lines.length" row.bind="this.rawRow" columns="this.rawColumns"
                             wrap="this.ui.wrap" version="this.ui.version" onReady.bind="this.onLineReady" startIndex="this.startIndex or 0"
                             activeIndex="this.ui.activeIndex" label="'Lines of the file'"/>
            </t>

            <!-- Structure -->
            <t t-elif="this.ui.mode === 'structure'">
                <div t-if="this.ui.structureError" class="o_dwo_txt_error">
                    <div class="alert alert-warning mb-2"><i class="oi me-2" data-icon="warning" aria-hidden="true"/><t t-out="this.ui.structureError"/></div>
                    <button type="button" class="btn btn-sm btn-secondary" t-on-click="() => this.setMode('raw')">Show the raw text</button>
                </div>
                <t t-else="">
                    <div class="o_dwo_txt_treebar">
                        <div class="o_dwo_txt_search">
                            <i class="oi" data-icon="search" aria-hidden="true"/>
                            <input type="search" class="form-control form-control-sm o_dwo_txt_tree_filter" t-att-placeholder="this.treeFilterLabel"
                                   t-att-aria-label="this.treeFilterLabel" t-on-input="(ev) => this.onTreeFilterInput(ev)"/>
                        </div>
                        <span t-if="this.ui.treeFilter" class="o_dwo_txt_tree_matches text-muted"><t t-out="this.ui.treeMatches"/> found</span>
                        <span class="text-muted o_dwo_txt_tree_size"><t t-out="this.treeSize.toLocaleString()"/> nodes</span>
                        <button type="button" class="btn btn-link btn-sm" t-att-disabled="!this.canExpandAll"
                                t-att-title="this.canExpandAll ? 'Expand all' : 'Too many nodes to expand all'" t-on-click="() => this.expandAll()">Expand all</button>
                        <button type="button" class="btn btn-link btn-sm" t-on-click="() => this.collapseAll()">Collapse all</button>
                    </div>
                    <div t-if="this.treeTruncated" class="o_dwo_txt_note alert alert-warning mb-0">Very large XML: only the first 200 000 elements are in the tree.</div>
                    <DwoTreeView rootId="this.treeRoot" label="'Structure of the file'" nameLabel="this.treeNameLabel" columns="this.treeColumns"
                                 version="this.ui.treeVersion" expanded="this.treeExpanded" getChildren.bind="this.treeChildren"
                                 isFolder.bind="this.treeIsFolder" row.bind="this.treeRow" onOpen.bind="this.onTreeOpen"
                                 onReady.bind="this.onTreeReady" onFocus.bind="this.onTreeFocus"/>
                    <div class="o_dwo_txt_path">
                        <code class="o_dwo_txt_path_text" t-out="this.ui.focusPath or ' '"/>
                        <button t-if="this.ui.focusPath" type="button" class="btn btn-link btn-sm" t-on-click="() => this.copyPath()">Copy path</button>
                        <button t-if="this.ui.focusLine" type="button" class="btn btn-link btn-sm o_dwo_txt_showline" t-on-click="() => this.showFocusLine()">
                            Show line <t t-out="this.ui.focusLine"/> in Raw
                        </button>
                    </div>
                </t>
            </t>

            <!-- Preview -->
            <t t-elif="this.ui.mode === 'preview'">
                <t t-if="this.group === 'markdown' or this.group === 'html' or this.group === 'notebook'">
                    <div t-if="this.frame.blocked" class="o_dwo_txt_note alert alert-info mb-0 o_dwo_txt_blocked">
                        <i class="oi me-2" data-icon="security" aria-hidden="true"/><t t-out="this.frame.blocked"/> picture(s) from the internet or other files are not loaded (privacy and safety). Download the file to see them.
                    </div>
                    <iframe class="o_dwo_txt_frame" title="Preview" sandbox="allow-popups allow-popups-to-escape-sandbox"
                            referrerpolicy="no-referrer" t-att-srcdoc="this.frame.html"/>
                </t>
                <div t-elif="this.group === 'svg'" class="o_dwo_txt_svg">
                    <img t-att-src="this.svgUrl" alt="Picture"/>
                </div>
                <t t-elif="this.group === 'log'">
                    <div class="o_dwo_txt_levels" role="group" aria-label="Log levels">
                        <button t-foreach="this.levelButtons" t-as="l" t-key="l.id" type="button"
                                class="btn btn-sm o_dwo_txt_level" t-att-class="'o_dwo_lvb_' + l.id + (l.on ? ' active' : '')"
                                t-att-aria-pressed="l.on ? 'true' : 'false'" t-att-data-level="l.id"
                                t-on-click="() => this.toggleLevel(l.id)">
                            <t t-out="l.label"/> <span class="badge rounded-pill" t-out="l.count"/>
                        </button>
                        <span class="text-muted ms-2 o_dwo_txt_log_shown"><t t-out="this.logCount.toLocaleString()"/> lines shown</span>
                    </div>
                    <DwoLineView t-key="'log' + this.ui.wrap" count="this.logCount" row.bind="this.logRow" columns="this.rawColumns"
                                 wrap="this.ui.wrap" version="this.ui.version" onReady.bind="this.onLineReady" label="'Log lines'"/>
                </t>
                <t t-elif="this.group === 'diff'">
                    <div class="o_dwo_txt_sub text-muted">
                        <t t-out="this.diffStats.files"/> file(s) changed,
                        <span class="o_dwo_diff_plus">+<t t-out="this.diffStats.adds"/></span>
                        <span class="o_dwo_diff_minus">−<t t-out="this.diffStats.dels"/></span>
                    </div>
                    <DwoLineView t-key="'diff' + this.ui.version" count="this.diff.rows.length" row.bind="this.diffRow" columns="this.diffColumns"
                                 wrap="true" onReady.bind="this.onLineReady" startIndex="this.startIndex or 0" label="'Changes'"/>
                </t>
                <t t-elif="this.group === 'subtitles'">
                    <div class="o_dwo_txt_sub text-muted"><t t-out="this.cues.length"/> cues<t t-if="this.cues.length">, until <t t-out="this.cues[this.cues.length - 1].end"/></t></div>
                    <DwoLineView count="this.cues.length" row.bind="this.cueRow" columns="'4rem 8rem 8rem minmax(0, 1fr)'"
                                 headers="['#', 'Start', 'End', 'Text']" wrap="true" label="'Subtitles'"/>
                </t>
                <t t-elif="this.group === 'po'">
                    <div class="o_dwo_txt_sub">
                        <span class="text-muted me-2" t-if="this.poLanguage" t-out="this.poLanguage"/>
                        <div class="btn-group btn-group-sm" role="group" aria-label="Show">
                            <button type="button" class="btn o_dwo_po_filter" t-att-class="this.ui.poFilter === 'all' ? 'btn-secondary' : 'btn-light'" data-filter="all" t-on-click="() => this.setPoFilter('all')">All <t t-out="this.poStats.total"/></button>
                            <button type="button" class="btn o_dwo_po_filter" t-att-class="this.ui.poFilter === 'missing' ? 'btn-secondary' : 'btn-light'" data-filter="missing" t-on-click="() => this.setPoFilter('missing')">Untranslated <t t-out="this.poStats.missing"/></button>
                            <button type="button" class="btn o_dwo_po_filter" t-att-class="this.ui.poFilter === 'fuzzy' ? 'btn-secondary' : 'btn-light'" data-filter="fuzzy" t-on-click="() => this.setPoFilter('fuzzy')">Fuzzy <t t-out="this.poStats.fuzzy"/></button>
                            <button type="button" class="btn o_dwo_po_filter" t-att-class="this.ui.poFilter === 'done' ? 'btn-secondary' : 'btn-light'" data-filter="done" t-on-click="() => this.setPoFilter('done')">Translated <t t-out="this.poStats.translated"/></button>
                        </div>
                    </div>
                    <DwoLineView t-key="'po' + this.ui.poFilter" count="this.poRows.length" row.bind="this.poRow" columns="'minmax(0, 1fr) minmax(0, 1fr) 14rem'"
                                 headers="['Source text', 'Translation', 'Used in']" wrap="true" label="'Translations'"/>
                </t>
            </t>
        </div>
    </t>
</templates>
