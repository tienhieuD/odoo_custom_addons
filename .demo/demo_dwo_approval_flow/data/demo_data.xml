<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!-- the users come from demo_users; here they get the purchase rights the demo needs -->
    <record id="demo_users.user_alice" model="res.users">
        <field name="group_ids" eval="[(4, ref('purchase.group_purchase_user'))]"/>
    </record>
    <record id="demo_users.user_bob" model="res.users">
        <field name="group_ids" eval="[(4, ref('purchase.group_purchase_manager'))]"/>
    </record>
    <record id="demo_users.user_carol" model="res.users">
        <field name="group_ids" eval="[(4, ref('purchase.group_purchase_manager'))]"/>
    </record>

    <!-- a user to try the configuration: Approvals > Flows (and the designer), plus the purchase rights to press buttons -->
    <record id="user_flow_admin" model="res.users" context="{'no_reset_password': True}">
        <field name="name">Dana Reed</field>
        <field name="login">demo_admin</field>
        <field name="password">demo</field>
        <field name="email">dana@example.com</field>
        <field name="group_ids" eval="[(6, 0, [ref('base.group_user'), ref('base.group_partner_manager'),
            ref('purchase.group_purchase_manager'), ref('dwo_approval_flow.group_approval_manager')])]"/>
    </record>

    <record id="vendor_gemini" model="res.partner">
        <field name="name">Gemini Furniture</field>
    </record>
    <record id="vendor_acme" model="res.partner">
        <field name="name">Acme Supplies</field>
    </record>

    <record id="product_chair" model="product.product">
        <field name="name">Office Chair</field>
        <field name="list_price">120</field>
        <field name="standard_price">100</field>
    </record>
    <record id="product_desk" model="product.product">
        <field name="name">Standing Desk</field>
        <field name="list_price">450</field>
        <field name="standard_price">400</field>
    </record>
    <record id="product_lamp" model="product.product">
        <field name="name">Desk Lamp</field>
        <field name="list_price">80</field>
        <field name="standard_price">60</field>
    </record>
</odoo>
