<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="module_category_expiry_tracker" model="ir.module.category">
            <field name="name">Expiry Tracker</field>
            <field name="sequence">30</field>
        </record>

        <record id="group_expiry_custom_user" model="res.groups">
            <field name="name">Custom Expiry User</field>
            <field name="category_id" ref="dwo_document_expiry_tracker.module_category_expiry_tracker"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <record id="rule_expiry_rule_company_scope" model="ir.rule">
            <field name="name">Expiry Rule Company Scope</field>
            <field name="model_id" ref="model_dwo_expiry_rule"/>
            <field name="global" eval="True"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>

        <record id="rule_expiry_rule_custom_own" model="ir.rule">
            <field name="name">Expiry Rule Custom User Own</field>
            <field name="model_id" ref="model_dwo_expiry_rule"/>
            <field name="groups" eval="[(4, ref('dwo_document_expiry_tracker.group_expiry_custom_user'))]"/>
            <field name="domain_force">[('rule_user_id', '=', user.id)]</field>
        </record>

        <record id="rule_expiry_record_company_scope" model="ir.rule">
            <field name="name">Expiry Record Company Scope</field>
            <field name="model_id" ref="model_dwo_expiry_record"/>
            <field name="global" eval="True"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>
    </data>
</odoo>
