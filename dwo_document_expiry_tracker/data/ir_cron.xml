<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="ir_cron_expiry_scan" model="ir.cron">
            <field name="name">Expiry Tracker - Phase 1: Scan Records</field>
            <field name="model_id" ref="model_dwo_expiry_rule"/>
            <field name="state">code</field>
            <field name="code">env['dwo.expiry.rule']._cron_scan_and_notify()</field>
            <field name="interval_number">15</field>
            <field name="interval_type">minutes</field>
            <field name="numbercall">-1</field>
            <field name="doall" eval="False"/>
            <field name="active" eval="True"/>
        </record>

        <record id="ir_cron_expiry_notify" model="ir.cron">
            <field name="name">Expiry Tracker - Phase 2: Send Notifications</field>
            <field name="model_id" ref="model_dwo_expiry_rule"/>
            <field name="state">code</field>
            <field name="code">env['dwo.expiry.rule']._cron_send_notifications()</field>
            <field name="interval_number">5</field>
            <field name="interval_type">minutes</field>
            <field name="numbercall">-1</field>
            <field name="doall" eval="False"/>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
