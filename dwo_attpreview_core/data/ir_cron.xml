<odoo noupdate="1">
    <record id="cron_cleanup_cache" model="ir.cron">
        <field name="name">Attachment Preview: clean cache</field>
        <field name="model_id" ref="model_dwo_attpreview_cache"/>
        <field name="state">code</field>
        <field name="code">model._cron_cleanup()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <!-- Odoo 17: numbercall defaults to 1 (run once then stop); -1 = every day, as on 18/19 -->
        <field name="numbercall">-1</field>
    </record>
</odoo>
