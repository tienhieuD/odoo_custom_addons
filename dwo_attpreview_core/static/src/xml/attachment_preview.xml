<templates xml:space="preserve">
    <t t-name="dwo_attpreview_core.Dialog">
        <Dialog size="'xl'" header="false" footer="false" withBodyPadding="false" fullscreen="state.fullscreen"
                contentClass="contentClass">
            <div class="o_dwo_ap" t-att-data-kind="state.info ? state.info.mode : ''">
                <div class="o_dwo_ap_bar">
                    <img class="o_dwo_ap_icon" t-att-src="iconUrl" alt=""/>
                    <h4 class="modal-title o_dwo_ap_title" t-att-title="fileName" t-esc="fileName"/>
                    <div class="o_dwo_ap_actions">
                        <button type="button" class="btn btn-link o_dwo_ap_download" title="Download" aria-label="Download" t-on-click="onDownload"><i class="fa fa-download"/></button>
                        <button t-if="canOpenInTab" type="button" class="btn btn-link o_dwo_ap_newtab" title="Open in a new tab" aria-label="Open in a new tab" t-on-click="onOpenInTab"><i class="fa fa-external-link"/></button>
                        <button type="button" class="btn btn-link o_dwo_ap_fullscreen" t-att-title="state.fullscreen ? 'Exit full screen' : 'Full screen'" t-att-aria-label="state.fullscreen ? 'Exit full screen' : 'Full screen'" t-on-click="toggleFullscreen"><i class="fa" t-att-class="state.fullscreen ? 'fa-compress' : 'fa-expand'"/></button>
                        <button type="button" class="btn btn-link o_dwo_ap_close" title="Close" aria-label="Close" t-on-click="props.close"><i class="fa fa-times"/></button>
                    </div>
                </div>
                <div t-if="notice and !state.noticeClosed" class="alert alert-warning o_dwo_ap_notice" role="alert">
                    <i class="fa fa-exclamation-triangle o_dwo_ap_notice_icon" aria-hidden="true"/>
                    <span class="o_dwo_ap_notice_text" t-esc="notice"/>
                    <button type="button" class="btn-close o_dwo_ap_notice_close" aria-label="Close" t-on-click="closeNotice"/>
                </div>
                <div class="o_dwo_ap_content" t-key="state.attachmentId">
                    <t t-if="state.info">
                        <t t-if="state.info.mode === 'native'">
                            <iframe t-if="nativeKind === 'pdf'" t-att-src="state.info.url"/>
                            <video t-elif="nativeKind === 'video'" t-att-src="state.info.url" controls="controls"/>
                            <audio t-elif="nativeKind === 'audio'" t-att-src="state.info.url" controls="controls"/>
                            <img t-else="" t-att-src="state.info.url" t-att-alt="fileName"/>
                        </t>
                        <t t-elif="state.info.mode === 'rendered'">
                            <t t-if="viewerComponent" t-component="viewerComponent" t-props="viewerProps"/>
                            <iframe t-elif="state.info.type === 'html'" t-att-srcdoc="state.info.content" sandbox=""/>
                            <pre t-elif="state.info.type === 'text'" t-esc="state.info.content"/>
                            <img t-else="" t-att-src="state.info.data_url" t-att-alt="fileName"/>
                        </t>
                        <div t-else="" class="alert alert-info o_dwo_ap_unavailable">
                            <t t-esc="reason"/>
                            <a t-att-href="downloadUrl" class="ms-2">Download</a>
                        </div>
                    </t>
                </div>
            </div>
        </Dialog>
    </t>
</templates>
