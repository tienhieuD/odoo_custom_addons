<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_dwo_mail_orphan_rule_list" model="ir.ui.view">
        <field name="name">dwo.mail.orphan.rule.list</field>
        <field name="model">dwo.mail.orphan.rule</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="sender_contains"/>
                <field name="subject_contains"/>
                <field name="recipient_contains"/>
                <field name="action"/>
                <field name="model_id"/>
                <field name="hit_count"/>
                <field name="active" column_invisible="True"/>
            </list>
        </field>
    </record>
    <record id="view_dwo_mail_orphan_rule_form" model="ir.ui.view">
        <field name="name">dwo.mail.orphan.rule.form</field>
        <field name="model">dwo.mail.orphan.rule</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <field name="active" invisible="1"/>
                    <div class="oe_title"><h1><field name="name" placeholder="Rule name"/></h1></div>
                    <group>
                        <group string="When an orphan email arrives and">
                            <field name="sender_contains" placeholder="e.g. @supplier.example"/>
                            <field name="subject_contains" placeholder="e.g. invoice"/>
                            <field name="recipient_contains" placeholder="e.g. info@"/>
                        </group>
                        <group string="Then">
                            <field name="sequence"/>
                            <field name="action"/>
                            <field name="model_id" invisible="action != 'route'" required="action == 'route'"/>
                            <field name="res_model" invisible="1"/>
                            <field name="res_id" invisible="action != 'route' or not res_model"
                                   required="action == 'route'"/>
                            <field name="hit_count"/>
                            <field name="last_hit"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_dwo_mail_orphan_rule" model="ir.actions.act_window">
        <field name="name">Rules</field>
        <field name="res_model">dwo.mail.orphan.rule</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="view_dwo_orphan_access_list" model="ir.ui.view">
        <field name="name">res.users.dwo.orphan.access.list</field>
        <field name="model">res.users</field>
        <field name="arch" type="xml">
            <list editable="bottom" create="0" delete="0">
                <field name="name" readonly="1"/>
                <field name="login" readonly="1"/>
                <field name="dwo_orphan_all_aliases"/>
                <field name="dwo_orphan_alias_ids" widget="many2many_tags" invisible="dwo_orphan_all_aliases"/>
            </list>
        </field>
    </record>
    <record id="action_dwo_orphan_access" model="ir.actions.act_window">
        <field name="name">Access by alias</field>
        <field name="res_model">res.users</field>
        <field name="view_mode">list</field>
        <field name="view_ids" eval="[(5, 0, 0), (0, 0, {'view_mode': 'list', 'view_id': ref('view_dwo_orphan_access_list')})]"/>
        <field name="domain" eval="[('share', '=', False), ('all_group_ids', 'in', [ref('group_dwo_orphan_manager')])]"/>
    </record>
</odoo>
