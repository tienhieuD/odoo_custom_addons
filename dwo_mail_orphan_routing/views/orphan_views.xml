<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_dwo_mail_orphan_list" model="ir.ui.view">
        <field name="name">dwo.mail.orphan.list</field>
        <field name="model">dwo.mail.orphan</field>
        <field name="arch" type="xml">
            <list create="0" decoration-muted="state == 'ignored'" decoration-success="state == 'routed'" decoration-bf="state == 'new'">
                <field name="date" width="150px"/>
                <field name="email_from" width="200px"/>
                <field name="subject" width="260px"/>
                <field name="body_preview" optional="show"/>
                <field name="rcpt_address" optional="show"/>
                <field name="attachment_count" string="Files" optional="show"/>
                <field name="target_display" optional="show"/>
                <field name="state" widget="badge" decoration-info="state == 'new'" decoration-success="state == 'routed'" decoration-muted="state == 'ignored'"/>
            </list>
        </field>
    </record>

    <record id="view_dwo_mail_orphan_form" model="ir.ui.view">
        <field name="name">dwo.mail.orphan.form</field>
        <field name="model">dwo.mail.orphan</field>
        <field name="arch" type="xml">
            <form create="0">
                <header>
                    <button name="action_route_wizard" type="object" string="Route to a record" class="btn-primary"
                            invisible="state == 'ignored'"/>
                    <button name="action_refresh_suggestions" type="object" string="Refresh suggestions"
                            invisible="state != 'new'"/>
                    <button name="action_ignore" type="object" string="Ignore" invisible="state != 'new'"/>
                    <button name="action_restore" type="object" string="Restore" invisible="state != 'ignored'"/>
                    <field name="state" widget="statusbar" statusbar_visible="new,routed"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="subject" placeholder="(no subject)"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="email_from"/>
                            <field name="author_id"/>
                            <field name="email_to"/>
                            <field name="email_cc" invisible="not email_cc"/>
                        </group>
                        <group>
                            <field name="date"/>
                            <field name="rcpt_address"/>
                            <field name="alias_id" invisible="not alias_id"/>
                            <field name="reason"/>
                        </group>
                    </group>
                    <group invisible="state != 'routed'">
                        <field name="target_display"/>
                        <field name="routed_user_id"/>
                        <field name="routed_date"/>
                        <field name="rule_id" invisible="not rule_id"/>
                        <button name="action_open_target" type="object" string="Open the record" class="btn-link"/>
                    </group>
                    <separator string="Suggested records" invisible="state != 'new'"/>
                    <field name="suggestion_ids" invisible="state != 'new'" nolabel="1">
                        <list create="0" delete="0" no_open="1">
                            <field name="model_name"/>
                            <field name="name"/>
                            <field name="reason"/>
                            <field name="score" widget="progressbar"/>
                            <button name="action_route" type="object" string="Route here" class="btn-primary"/>
                            <button name="action_open_record" type="object" string="Open" icon="fa-external-link"/>
                        </list>
                    </field>
                    <notebook>
                        <page string="Message" name="message">
                            <field name="body_html" widget="html" options="{'safe': True}"/>
                        </page>
                        <page string="Attachments" name="attachments">
                            <field name="attachment_ids" widget="many2many_binary" readonly="1"/>
                        </page>
                        <page string="Headers" name="headers">
                            <group>
                                <field name="message_id"/>
                                <field name="in_reply_to"/>
                                <field name="references"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_dwo_mail_orphan_search" model="ir.ui.view">
        <field name="name">dwo.mail.orphan.search</field>
        <field name="model">dwo.mail.orphan</field>
        <field name="arch" type="xml">
            <search>
                <field name="subject"/>
                <field name="email_from"/>
                <field name="rcpt_address"/>
                <field name="alias_id"/>
                <field name="body_preview" string="Content"/>
                <filter name="new" string="New" domain="[('state', '=', 'new')]"/>
                <filter name="routed" string="Routed" domain="[('state', '=', 'routed')]"/>
                <filter name="ignored" string="Ignored" domain="[('state', '=', 'ignored')]"/>
                <separator/>
                <filter name="has_attachments" string="With attachments" domain="[('attachment_ids', '!=', False)]"/>
                <filter name="with_suggestion" string="With suggestions" domain="[('suggestion_ids', '!=', False)]"/>
                <separator/>
                <filter name="date" string="Date" date="date"/>
                <group>
                    <filter name="group_rcpt" string="Received at" context="{'group_by': 'rcpt_address'}"/>
                    <filter name="group_sender" string="Sender" context="{'group_by': 'email_from'}"/>
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                    <filter name="group_week" string="Week" context="{'group_by': 'date:week'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_dwo_mail_orphan_pivot" model="ir.ui.view">
        <field name="name">dwo.mail.orphan.pivot</field>
        <field name="model">dwo.mail.orphan</field>
        <field name="arch" type="xml">
            <pivot string="Orphan emails">
                <field name="rcpt_address" type="row"/>
                <field name="date" interval="week" type="col"/>
            </pivot>
        </field>
    </record>

    <record id="view_dwo_mail_orphan_graph" model="ir.ui.view">
        <field name="name">dwo.mail.orphan.graph</field>
        <field name="model">dwo.mail.orphan</field>
        <field name="arch" type="xml">
            <graph string="Orphan emails per week" type="bar" stacked="1">
                <field name="date" interval="week"/>
                <field name="rcpt_address"/>
            </graph>
        </field>
    </record>

    <record id="action_dwo_mail_orphan" model="ir.actions.act_window">
        <field name="name">Orphan inbox</field>
        <field name="res_model">dwo.mail.orphan</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_new': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No orphan email</p>
            <p>Incoming emails that Odoo cannot attach to a record are kept here.</p>
        </field>
    </record>

    <record id="action_dwo_mail_orphan_report" model="ir.actions.act_window">
        <field name="name">Lost emails per alias</field>
        <field name="res_model">dwo.mail.orphan</field>
        <field name="view_mode">graph,pivot,list</field>
        <field name="view_id" ref="view_dwo_mail_orphan_graph"/>
    </record>

    <record id="action_dwo_mail_orphan_route" model="ir.actions.act_window">
        <field name="name">Route to a record</field>
        <field name="res_model">dwo.mail.orphan.route.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="model_dwo_mail_orphan"/>
        <field name="binding_view_types">list</field>
    </record>

    <record id="action_dwo_mail_orphan_ignore" model="ir.actions.server">
        <field name="name">Ignore</field>
        <field name="model_id" ref="model_dwo_mail_orphan"/>
        <field name="binding_model_id" ref="model_dwo_mail_orphan"/>
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code">records.action_ignore()</field>
    </record>
</odoo>
