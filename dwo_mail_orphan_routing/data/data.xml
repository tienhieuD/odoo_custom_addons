<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="param_enabled" model="ir.config_parameter">
        <field name="key">dwo_orphan.enabled</field>
        <field name="value">1</field>
    </record>
    <record id="param_digest" model="ir.config_parameter">
        <field name="key">dwo_orphan.digest</field>
        <field name="value">1</field>
    </record>
    <record id="param_keep_days" model="ir.config_parameter">
        <field name="key">dwo_orphan.keep_days</field>
        <field name="value">90</field>
    </record>
    <record id="cron_dwo_orphan_daily" model="ir.cron">
        <field name="name">Orphan Mail Router: daily digest and clean-up</field>
        <field name="model_id" ref="model_dwo_mail_orphan"/>
        <field name="state">code</field>
        <field name="code">model._cron_daily()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
    </record>
</odoo>
