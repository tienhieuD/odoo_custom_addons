<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="web_split_view.SplitView.Buttons">
        <div class="o_split_buttons_view d-flex gap-1" role="toolbar" aria-label="Main actions">
            <button type="button"
                    class="btn btn-primary o_split_button_create" title="Create record"
                    t-on-click="onCreate">New</button>
        </div>
    </t>

    <t t-name="web_split_view.SplitView">
        <div class="o_split_view h-100 d-flex flex-column" t-ref="root" t-att-class="props.className">
            <Layout display="layoutDisplay" className="'o_split_layout flex-grow-1 overflow-hidden'">
                <t t-set-slot="layout-buttons">
                    <t t-call="{{ props.buttonTemplate }}"/>
                </t>
                <div class="duo_split_view d-flex w-100 h-100" t-ref="split">
                    <div class="left-side border-end overflow-auto" t-attf-style="width: {{ state.leftWidth }}%">
                        <SplitPane viewProps="listProps" splitState="state" onClose="closePane" t-key="state.listKey"/>
                    </div>
                    <div class="split_resizer" title="Resize" t-on-mousedown="startResize">
                        <span/><span/><span/><span/><span/>
                    </div>
                    <div class="right-side overflow-auto position-relative flex-grow-1" t-attf-style="width: {{ 100 - state.leftWidth }}%">
                        <button t-if="state.mode === 'record'" type="button"
                                class="btn btn-light o_split_expand" title="Open in full form view"
                                aria-label="Open in full form view" t-on-click="onExpand">
                            <i class="fa fa-expand"/>
                        </button>
                        <t t-if="state.mode === 'empty'">
                            <p class="form-placeholder text-muted fst-italic text-center position-absolute top-50 start-50 translate-middle"
                               t-out="placeholder"/>
                        </t>
                        <t t-else="">
                            <SplitPane viewProps="formProps" splitState="state" onClose="closePane" t-key="state.formKey"/>
                        </t>
                    </div>
                </div>
            </Layout>
        </div>
    </t>

    <t t-name="web_split_view.SplitPane">
        <View t-props="props.viewProps"/>
    </t>

</templates>
