<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="web_split_view.SplitView.Buttons">
        <div class="o_split_buttons_view d-flex gap-1" role="toolbar" aria-label="Main actions">
            <button type="button"
                    class="btn btn-primary o_split_button_create" title="Create record"
                    t-on-click="() => this.onCreate()">New</button>
        </div>
    </t>

    <t t-name="web_split_view.SplitView">
        <div class="o_split_view h-100 d-flex flex-column" t-ref="this.rootRef" t-att-class="this.props.className">
            <Layout display="this.layoutDisplay" className="'o_split_layout flex-grow-1 overflow-hidden'">
                <t t-set-slot="control-panel-buttons">
                    <t t-call="{{ this.props.buttonTemplate }}"/>
                </t>
                <div class="duo_split_view d-flex w-100 h-100" t-ref="this.splitRef">
                    <div class="left-side border-end overflow-auto" t-attf-style="width: {{ this.state.leftWidth }}%">
                        <SplitPane viewProps="this.listProps" splitState="this.state" onClose="this.closePane" t-key="this.state.listKey"/>
                    </div>
                    <div class="split_resizer" title="Resize" t-on-mousedown="(ev) => this.startResize(ev)">
                        <span/><span/><span/><span/><span/>
                    </div>
                    <div class="right-side overflow-auto position-relative flex-grow-1" t-attf-style="width: {{ 100 - this.state.leftWidth }}%">
                        <button t-if="this.state.mode === 'record'" type="button"
                                class="btn btn-light o_split_expand" title="Open in full form view"
                                aria-label="Open in full form view" t-on-click="() => this.onExpand()">
                            <i class="fa fa-expand"/>
                        </button>
                        <t t-if="this.state.mode === 'empty'">
                            <p class="form-placeholder text-muted fst-italic text-center position-absolute top-50 start-50 translate-middle"
                               t-out="this.placeholder"/>
                        </t>
                        <t t-else="">
                            <SplitPane viewProps="this.formProps" splitState="this.state" onClose="this.closePane" t-key="this.state.formKey"/>
                        </t>
                    </div>
                </div>
            </Layout>
        </div>
    </t>

    <t t-name="web_split_view.SplitPane">
        <View t-props="this.props.viewProps"/>
    </t>

</templates>
