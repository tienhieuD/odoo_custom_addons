<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="assets_backend" name="Web Split View assets" inherit_id="web.assets_backend">
        <xpath expr="//link[last()]" position="after">
            <link rel="stylesheet" type="text/scss" href="/web_split_view/static/src/scss/split_view.scss"/>
        </xpath>
        <xpath expr="//script[last()]" position="after">
            <script type="text/javascript" src="/web_split_view/static/src/js/split_listview.js"/>
            <script type="text/javascript" src="/web_split_view/static/src/js/split_formview.js"/>
            <script type="text/javascript" src="/web_split_view/static/src/js/split_view.js"/>
            <!-- Odoo 12 has no web.assets_tests bundle: the tours are registered with the backend assets -->
            <script type="text/javascript" src="/web_split_view/static/tests/tours/split_view_tour.js"/>
        </xpath>
    </template>
</odoo>
