<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="dwo_form_focus_mode.FormView" t-inherit="web.FormView" t-inherit-mode="extension">
        <xpath expr="//div[@t-ref='this.rootRef']" position="inside">
            <button t-if="this.dwoFfmEnabled and this.dwoFfmMode !== 'normal'" type="button" class="btn btn-secondary o_dwo_ffm_drawer_btn"
                    t-att-title="this.dwoFfm.drawer ? 'Close the chatter' : 'Open the chatter'" t-on-click.stop="() => this.dwoFfmToggleDrawer()">
                <i class="fa" t-att-class="this.dwoFfm.drawer ? 'fa-times' : 'fa-comments'" role="img"/>
            </button>
        </xpath>
    </t>

    <t t-name="dwo_form_focus_mode.Button">
        <button t-if="this.ffm.dwoFfmEnabled" type="button" class="btn btn-outline-secondary o_dwo_ffm_toggle" t-att-class="{ active: this.ffm.dwoFfmMode !== 'normal' }"
                t-att-data-mode="this.ffm.dwoFfmMode" t-att-data-tooltip="this.ffm.dwoFfmTitle" t-on-click.stop="() => this.ffm.dwoFfmCycle()">
            <i class="fa me-1" t-att-class="this.ffm.dwoFfmIcon" role="img"/><span class="o_dwo_ffm_label d-none d-xl-inline" t-esc="this.ffm.dwoFfmLabel"/>
        </button>
    </t>

    <t t-name="dwo_form_focus_mode.ControlPanel" t-inherit="web.ControlPanel" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('o_cp_pager')]" position="before">
            <DwoFfmButton t-if="this.env.dwoFfm"/>
        </xpath>
    </t>
</templates>
