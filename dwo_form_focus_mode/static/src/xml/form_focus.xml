<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="dwo_form_focus_mode.FormView" t-inherit="web.FormView" t-inherit-mode="extension">
        <xpath expr="//div[@t-ref='this.rootRef']" position="inside">
            <!-- click on the dimmed background closes the drawer -->
            <div t-if="this.dwoFfmEnabled and this.dwoFfmMode !== 'normal' and this.dwoFfm.drawer" class="o_dwo_ffm_backdrop" t-on-click.stop="() => this.dwoFfmToggleDrawer()"/>
            <button t-if="this.dwoFfmEnabled and this.dwoFfmMode !== 'normal'" type="button" class="btn btn-secondary o_dwo_ffm_drawer_btn" t-att-class="{ o_dwo_ffm_open: this.dwoFfm.drawer }"
                    t-att-title="this.dwoFfm.drawer ? 'Close the chatter' : 'Open the chatter'" t-on-click.stop="() => this.dwoFfmToggleDrawer()">
                <i class="fa" t-att-class="this.dwoFfm.drawer ? 'fa-times' : 'fa-comments'" role="img"/><span class="o_dwo_ffm_drawer_label ms-1" t-if="!this.dwoFfm.drawer">Chatter</span>
            </button>
        </xpath>
    </t>

    <t t-name="dwo_form_focus_mode.Button">
        <nav t-if="this.ffm.dwoFfmEnabled" class="o_dwo_ffm_switch d-print-none d-inline-flex btn-group">
            <t t-foreach="['normal', 'wide', 'focus']" t-as="mode" t-key="mode">
                <button type="button" class="btn btn-secondary o_dwo_ffm_toggle" t-att-class="{ active: this.ffm.dwoFfmMode === mode }"
                        t-att-data-mode="mode" t-att-data-tooltip="this.ffm.dwoFfmTitleOf(mode)" t-att-aria-label="this.ffm.dwoFfmTitleOf(mode)"
                        t-on-click.stop="() => this.ffm.dwoFfmSet(mode)">
                    <svg t-if="mode === 'normal'" class="o_dwo_ffm_icon" viewBox="0 0 16 16" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="1.5" y="2.5" width="13" height="11" rx="1.5"/><path d="M10.5 2.5v11"/></svg>
                    <svg t-elif="mode === 'wide'" class="o_dwo_ffm_icon" viewBox="0 0 16 16" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="1.5" y="2.5" width="13" height="11" rx="1.5"/><path d="M4.5 8h7M6.5 6L4.5 8l2 2M9.5 6l2 2-2 2"/></svg>
                    <svg t-else="" class="o_dwo_ffm_icon" viewBox="0 0 16 16" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2 6V2h4M10 2h4v4M14 10v4h-4M6 14H2v-4"/><rect x="6" y="6" width="4" height="4" rx=".5"/></svg>
                </button>
            </t>
        </nav>
    </t>

    <t t-name="dwo_form_focus_mode.ControlPanel" t-inherit="web.ControlPanel" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('o_cp_pager')]" position="before">
            <DwoFfmButton t-if="this.env.dwoFfm"/>
        </xpath>
    </t>
</templates>
