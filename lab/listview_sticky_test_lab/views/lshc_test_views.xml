<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="lshc_test_record_view_list" model="ir.ui.view">
        <field name="name">lshc.test.record.list</field>
        <field name="model">lshc.test.record</field>
        <field name="arch" type="xml">
            <list string="lshc.test.record.list">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code" widget="CopyClipboardChar"/>
                <field name="category_id"/>
                <field name="state" widget="badge"/>
                <field name="priority" widget="priority"/>
                <field name="kanban_state" widget="state_selection"/>
                <field name="user_id"/>
                <field name="partner_id"/>
                <field name="country_id"/>
                <field name="city"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="amount"/>
                <field name="amount_tax"/>
                <field name="amount_total"/>
                <field name="qty"/>
                <field name="price"/>
                <field name="discount" widget="percentage"/>
                <field name="progress" widget="progressbar"/>
                <field name="rating_pie" widget="percentpie"/>
                <field name="duration" widget="float_time"/>
                <field name="factor" widget="float_factor" options="{'factor': 0.5}"/>
                <field name="active_toggle" widget="boolean_toggle"/>
                <field name="favorite" widget="boolean_favorite"/>
                <field name="is_vip"/>
                <field name="flag_icon" widget="boolean_icon" options="{'icon': 'fa-check-circle'}"/>
                <field name="date_start"/>
                <field name="date_end" widget="remaining_days"/>
                <field name="datetime_created"/>
                <field name="datetime_due"/>
                <field name="email" widget="email"/>
                <field name="phone" widget="phone"/>
                <field name="website" widget="url"/>
                <field name="website_copy" widget="CopyClipboardURL"/>
                <field name="color_hex" widget="color"/>
                <field name="color_index" widget="color_picker"/>
                <field name="tag_ids" widget="many2many_tags" options="{'color_field': 'color'}"/>
                <field name="follower_ids" widget="many2many_tags_avatar"/>
                <field name="kind" widget="selection_badge"/>
                <field name="description"/>
                <field name="ref_char"/>
                <field name="serial"/>
                <field name="weight"/>
                <field name="volume"/>
                <field name="height"/>
                <field name="width"/>
                <field name="stock"/>
                <field name="score_a"/>
                <field name="score_b"/>
                <field name="score_c"/>
                <field name="notes" widget="text"/>
                <field name="image" widget="image" options="{'size': [32, 32]}"/>
            </list>
        </field>
    </record>
    <record id="lshc_test_record_view_list_editable" model="ir.ui.view">
        <field name="name">lshc.test.record.list.editable</field>
        <field name="model">lshc.test.record</field>
        <field name="arch" type="xml">
            <list string="lshc.test.record.list.editable" editable="top">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code" widget="CopyClipboardChar"/>
                <field name="category_id"/>
                <field name="state" widget="badge"/>
                <field name="priority" widget="priority"/>
                <field name="kanban_state" widget="state_selection"/>
                <field name="user_id"/>
                <field name="partner_id"/>
                <field name="country_id"/>
                <field name="city"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="amount"/>
                <field name="amount_tax"/>
                <field name="amount_total"/>
                <field name="qty"/>
                <field name="price"/>
                <field name="discount" widget="percentage"/>
                <field name="progress" widget="progressbar"/>
                <field name="duration" widget="float_time"/>
                <field name="factor" widget="float_factor" options="{'factor': 0.5}"/>
                <field name="active_toggle" widget="boolean_toggle"/>
                <field name="favorite" widget="boolean_favorite"/>
                <field name="is_vip"/>
                <field name="flag_icon" widget="boolean_icon" options="{'icon': 'fa-check-circle'}"/>
                <field name="date_start"/>
                <field name="date_end" widget="remaining_days"/>
                <field name="datetime_created"/>
                <field name="email" widget="email"/>
                <field name="phone" widget="phone"/>
                <field name="website" widget="url"/>
                <field name="color_index" widget="color_picker"/>
                <field name="tag_ids" widget="many2many_tags" options="{'color_field': 'color'}"/>
                <field name="kind" widget="selection_badge"/>
                <field name="description"/>
                <field name="weight"/>
                <field name="volume"/>
                <field name="height"/>
                <field name="width"/>
                <field name="stock"/>
            </list>
        </field>
    </record>
    <record id="lshc_test_record_view_form" model="ir.ui.view">
        <field name="name">lshc.test.record.form</field>
        <field name="model">lshc.test.record</field>
        <field name="arch" type="xml">
            <form string="Test record">
                <header>
                    <field name="state" widget="statusbar" options="{'clickable': '1'}"/>
                </header>
                <sheet>
                    <field name="image" widget="image" class="oe_avatar"/>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Name"/></h1>
                    </div>
                    <group>
                        <group string="Main">
                            <field name="name"/>
                            <field name="code" widget="CopyClipboardChar"/>
                            <field name="category_id"/>
                            <field name="user_id"/>
                            <field name="partner_id"/>
                            <field name="country_id"/>
                            <field name="city"/>
                            <field name="date_start"/>
                            <field name="date_end" widget="remaining_days"/>
                            <field name="tag_ids"/>
                            <field name="priority" widget="priority"/>
                            <field name="kanban_state" widget="state_selection"/>
                            <field name="kind"/>
                        </group>
                        <group string="Amounts">
                            <field name="currency_id"/>
                            <field name="amount"/>
                            <field name="amount_tax"/>
                            <field name="amount_total"/>
                            <field name="qty"/>
                            <field name="price"/>
                            <field name="discount" widget="percentage"/>
                            <field name="progress" widget="progressbar"/>
                            <field name="rating_pie" widget="percentpie"/>
                            <field name="duration" widget="float_time"/>
                        </group>
                    </group>
                    <group string="Full width list - 7 columns (not in a tab)">
                        <field name="line_small_ids" nolabel="1" context="{'default_kind': 'small'}">
                            <list>
                                <field name="sequence" widget="handle"/>
                                <field name="name"/>
                                <field name="qty"/>
                                <field name="price"/>
                                <field name="total"/>
                                <field name="state" widget="badge"/>
                                <field name="currency_id" column_invisible="1"/>
                            </list>
                        </field>
                    </group>
                    <notebook>
                        <page string="Medium - editable" name="medium">
                            <field name="line_medium_ids" nolabel="1" context="{'default_kind': 'medium'}">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="product"/>
                                    <field name="qty"/>
                                    <field name="price"/>
                                    <field name="discount"/>
                                    <field name="total"/>
                                    <field name="currency_id" column_invisible="1"/>
                                    <field name="state" widget="badge"/>
                                    <field name="partner_id"/>
                                    <field name="user_id"/>
                                    <field name="date"/>
                                    <field name="deadline"/>
                                    <field name="progress" widget="progressbar"/>
                                    <field name="priority" widget="priority"/>
                                    <field name="flag" widget="boolean_toggle"/>
                                    <field name="tag_ids" widget="many2many_tags" options="{'color_field': 'color'}"/>
                                </list>
                            </field>
                        </page>
                        <page string="Large - 38 columns" name="large">
                            <field name="line_large_ids" nolabel="1" context="{'default_kind': 'large'}">
                                <list>
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="product"/>
                                    <field name="qty"/>
                                    <field name="price"/>
                                    <field name="discount"/>
                                    <field name="total"/>
                                    <field name="currency_id" column_invisible="1"/>
                                    <field name="state" widget="badge"/>
                                    <field name="partner_id"/>
                                    <field name="user_id"/>
                                    <field name="date"/>
                                    <field name="deadline"/>
                                    <field name="progress" widget="progressbar"/>
                                    <field name="priority" widget="priority"/>
                                    <field name="flag" widget="boolean_toggle"/>
                                    <field name="email" widget="email"/>
                                    <field name="phone" widget="phone"/>
                                    <field name="url" widget="url"/>
                                    <field name="tag_ids" widget="many2many_tags" options="{'color_field': 'color'}"/>
                                    <field name="color_index" widget="color_picker"/>
                                    <field name="note"/>
                                    <field name="f01"/>
                                    <field name="f02"/>
                                    <field name="f03"/>
                                    <field name="f04"/>
                                    <field name="f05"/>
                                    <field name="f06"/>
                                    <field name="f07"/>
                                    <field name="f08"/>
                                    <field name="f09"/>
                                    <field name="f10"/>
                                    <field name="f11"/>
                                    <field name="f12"/>
                                </list>
                            </field>
                        </page>
                        <page string="Half width lists" name="half">
                            <group>
                                <group string="Left half (7 columns)">
                                    <field name="line_left_ids" nolabel="1" context="{'default_kind': 'left'}">
                                        <list>
                                            <field name="sequence" widget="handle"/>
                                            <field name="name"/>
                                            <field name="qty"/>
                                            <field name="price"/>
                                            <field name="total"/>
                                            <field name="state" widget="badge"/>
                                            <field name="currency_id" column_invisible="1"/>
                                        </list>
                                    </field>
                                </group>
                                <group string="Right half (17 columns, editable)">
                                    <field name="line_right_ids" nolabel="1" context="{'default_kind': 'right'}">
                                        <list editable="bottom">
                                            <field name="sequence" widget="handle"/>
                                            <field name="name"/>
                                            <field name="product"/>
                                            <field name="qty"/>
                                            <field name="price"/>
                                            <field name="discount"/>
                                            <field name="total"/>
                                            <field name="currency_id" column_invisible="1"/>
                                            <field name="state" widget="badge"/>
                                            <field name="partner_id"/>
                                            <field name="user_id"/>
                                            <field name="date"/>
                                            <field name="deadline"/>
                                            <field name="progress" widget="progressbar"/>
                                            <field name="priority" widget="priority"/>
                                            <field name="flag" widget="boolean_toggle"/>
                                            <field name="tag_ids" widget="many2many_tags" options="{'color_field': 'color'}"/>
                                        </list>
                                    </field>
                                </group>
                            </group>
                        </page>
                        <page string="More fields" name="more">
                            <group>
                                <group>
                                    <field name="email" widget="email"/>
                                    <field name="phone" widget="phone"/>
                                    <field name="website" widget="url"/>
                                    <field name="website_copy" widget="CopyClipboardURL"/>
                                    <field name="color_hex" widget="color"/>
                                    <field name="color_index" widget="color_picker"/>
                                    <field name="follower_ids" widget="many2many_tags_avatar"/>
                                    <field name="description"/>
                                    <field name="ref_char"/>
                                    <field name="serial"/>
                                    <field name="weight"/>
                                    <field name="volume"/>
                                </group>
                                <group>
                                    <field name="height"/>
                                    <field name="width"/>
                                    <field name="stock"/>
                                    <field name="score_a"/>
                                    <field name="score_b"/>
                                    <field name="score_c"/>
                                    <field name="factor" widget="float_factor"/>
                                    <field name="active_toggle" widget="boolean_toggle"/>
                                    <field name="favorite" widget="boolean_favorite"/>
                                    <field name="is_vip"/>
                                    <field name="flag_icon" widget="boolean_icon"/>
                                    <field name="datetime_created"/>
                                    <field name="datetime_due"/>
                                </group>
                            </group>
                            <field name="notes" placeholder="Notes"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
    <record id="lshc_test_record_view_search" model="ir.ui.view">
        <field name="name">lshc.test.record.search</field>
        <field name="model">lshc.test.record</field>
        <field name="arch" type="xml">
            <search string="Test records">
                <field name="name" string="Name / Code" filter_domain="['|', ('name', 'ilike', self), ('code', 'ilike', self)]"/>
                <field name="partner_id"/>
                <field name="user_id"/>
                <filter name="favorite" string="Favorites" domain="[('favorite', '=', True)]"/>
                <filter name="vip" string="VIP" domain="[('is_vip', '=', True)]"/>
                <filter name="late" string="Overdue" domain="[('date_end', '&lt;', context_today().strftime('%Y-%m-%d')), ('state', 'not in', ('done', 'cancel'))]"/>
                <separator/>
                <filter name="high" string="High priority" domain="[('priority', 'in', ('2', '3'))]"/>
                <group>
                    <filter name="group_category" string="Category" context="{'group_by': 'category_id'}"/>
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                    <filter name="group_user" string="Responsible" context="{'group_by': 'user_id'}"/>
                    <filter name="group_country" string="Country" context="{'group_by': 'country_id'}"/>
                </group>
                <searchpanel>
                    <field name="category_id" string="Category" icon="fa-folder" enable_counters="1"/>
                    <field name="state" string="Status" select="multi" icon="fa-flag" enable_counters="1"/>
                    <field name="priority" string="Priority" select="multi" icon="fa-star"/>
                </searchpanel>
            </search>
        </field>
    </record>
</odoo>
