+			if (r < i && (d -= i - r, r = i), c < a && (m -= a - c, c = a), t.col > s && r < l && (d -= l - r, r = l), t.row > o && c < u && (m -= u - c, c = u), d <= 0 || m <= 0 || r >= dwoW || c >= dwoH) continue;
