+                <xdr:spPr>
+                  <a:xfrm{flip}><a:off x="0" y="0"/><a:ext {ext}/></a:xfrm>
+                  <a:prstGeom prst="straightConnector1"><a:avLst/></a:prstGeom>
+                  {ln}
+                </xdr:spPr>
+              </xdr:cxnSp>
+              <xdr:clientData/>
+            </xdr:twoCellAnchor></xdr:wsDr>"#
+        )
