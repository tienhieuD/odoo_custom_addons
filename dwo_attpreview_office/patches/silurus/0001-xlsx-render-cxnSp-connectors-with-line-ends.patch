+function isQuarterTurnedStandaloneConnector(shape: ShapeInfo): boolean {
+  if (!isConnectorShape(shape)) return false;
+  if (shape.x !== 0 || shape.y !== 0 || shape.w !== 1 || shape.h !== 1) return false;
