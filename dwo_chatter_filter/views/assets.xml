<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="assets_backend" name="Message Filter on Chatter assets" inherit_id="web.assets_backend">
        <xpath expr="//link[last()]" position="after">
            <link rel="stylesheet" type="text/scss" href="/dwo_chatter_filter/static/src/filter/dwo_message_filter.scss"/>
        </xpath>
        <xpath expr="//script[last()]" position="after">
            <script type="text/javascript" src="/dwo_chatter_filter/static/src/js/dwo_chatter_filter.js"/>
        </xpath>
    </template>

    <template id="assets_tests" name="Message Filter on Chatter tours" inherit_id="web.assets_tests">
        <xpath expr="." position="inside">
            <script type="text/javascript" src="/dwo_chatter_filter/static/tests/tours/filter_tour.js"/>
        </xpath>
    </template>
</odoo>
