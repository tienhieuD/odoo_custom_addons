<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="dwo_chatter_filter.MessageFilter">
        <div t-if="state.counts" class="o-dwo-messageFilter d-flex flex-wrap align-items-center gap-1 px-3 py-2 d-print-none">
            <button t-foreach="items" t-as="item" t-key="item.label" type="button"
                    class="o-dwo-filterBadge badge rounded-pill border fw-normal d-inline-flex align-items-center gap-1"
                    t-att-class="{
                        'text-bg-primary border-primary': isActive(item),
                        'text-bg-light': !isActive(item),
                        'o-dwo-filterEmpty': item.count === 0 and item.id,
                    }"
                    t-att-data-kind="item.id or 'all'"
                    t-att-disabled="item.count === 0 and item.id and !isActive(item)"
                    t-on-click="() => this.select(item)">
                <span t-out="item.label"/>
                <span class="o-dwo-filterCount fw-bold" t-out="item.count"/>
            </button>
        </div>
    </t>
</templates>
