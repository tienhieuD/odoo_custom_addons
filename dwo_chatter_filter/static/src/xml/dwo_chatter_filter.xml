<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <!-- The chips at the top of the chatter. Odoo 12: a widget template (the chatter is not made of Owl components) -->
    <t t-name="dwo_chatter_filter.MessageFilter">
        <span class="o-dwo-filterLabel text-muted mr-1">Filter by:</span>
        <t t-foreach="items" t-as="item">
            <button type="button"
                    t-attf-class="o-dwo-filterBadge badge badge-pill border d-inline-flex align-items-center font-weight-normal mr-1 mb-1 #{item.active ? 'o-dwo-filterActive' : ''} #{item.disabled ? 'o-dwo-filterEmpty' : ''}"
                    t-att-style="item.style"
                    t-att-data-chip="item.id or 'all'"
                    t-att-data-chip-name="item.label"
                    t-att-disabled="item.disabled ? 'disabled' : undefined">
                <span><t t-esc="item.label"/></span>
                <span class="o-dwo-filterCount font-weight-bold ml-1"><t t-esc="item.count === null ? '?' : item.count"/></span>
            </button>
        </t>
        <button t-if="isAdmin" type="button" class="o-dwo-filterEdit btn btn-link btn-sm p-0 ml-1">Edit</button>
    </t>
</templates>
