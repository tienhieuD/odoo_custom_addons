<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="dwo_chatter_filter.MessageFilter" owl="1">
        <div t-if="state.data" class="o-dwo-messageFilter d-flex flex-wrap align-items-center gap-1 px-3 py-2 d-print-none">
            <span class="o-dwo-filterLabel text-muted me-1">Filter by:</span>
            <button t-foreach="items" t-as="item" t-key="item.id or 'all'" type="button"
                    class="o-dwo-filterBadge badge rounded-pill border d-inline-flex align-items-center gap-1 fw-normal"
                    t-att-class="{
                        'o-dwo-filterActive': isActive(item),
                        'o-dwo-filterEmpty': isDisabled(item),
                    }"
                    t-att-style="chipStyle(item)"
                    t-att-data-chip="item.id or 'all'"
                    t-att-data-chip-name="item.label"
                    t-att-disabled="isDisabled(item)"
                    t-on-click="() => this.select(item)">
                <span t-esc="item.label"/>
                <span class="o-dwo-filterCount fw-bold" t-esc="item.count === null ? '?' : item.count"/>
            </button>
            <div class="o-dwo-filterSearch position-relative d-inline-flex align-items-center ms-1">
                <input type="text" class="o-dwo-filterSearchInput form-control form-control-sm rounded-pill"
                       placeholder="Search messages..." t-att-value="state.text"
                       t-on-input="onSearchInput" t-on-keydown="onSearchKeydown"/>
                <button t-if="state.text" type="button" class="o-dwo-filterSearchClear btn btn-link btn-sm p-0 position-absolute end-0 me-2"
                        title="Clear" aria-label="Clear" t-on-click="() => this.clearSearch()">&#215;</button>
            </div>
            <button t-if="isAdmin" type="button" class="o-dwo-filterEdit btn btn-link btn-sm p-0 ms-1"
                    t-on-click="() => this.edit()">Edit</button>
        </div>
    </t>
</templates>
