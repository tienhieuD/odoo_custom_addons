<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-inherit="mail.Chatter" t-inherit-mode="extension">
        <!-- First thing of the content: right under Send message, Log note and Activity -->
        <xpath expr="//div[hasclass('o-mail-Chatter-content')]/t" position="before">
            <DwoMessageFilter t-if="state.thread.id and !messageSearch.searching and !messageSearch.searched" thread="state.thread"/>
        </xpath>
    </t>
</templates>
