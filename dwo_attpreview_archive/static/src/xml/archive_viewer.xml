<templates xml:space="preserve">
    <t t-name="dwo_attpreview_archive.TreeView">
        <div class="o_dwo_tree">
            <div class="o_dwo_tree_head" aria-hidden="true">
                <span class="o_dwo_tree_col_name">Name</span>
                <span class="o_dwo_tree_col_size">Size</span>
                <span class="o_dwo_tree_col_date">Modified</span>
                <span class="o_dwo_tree_col_act"/>
            </div>
            <div class="o_dwo_tree_scroll" t-ref="scroll">
                <div class="o_dwo_tree_list" t-ref="list" role="tree" t-att-aria-label="props.label or 'Files'"
                     t-attf-style="height: {{ totalHeight }}px;">
                    <div t-foreach="rows" t-as="row" t-key="row.key" class="o_dwo_tree_row"
                         t-att-class="{ 'o_dwo_tree_focused': row.focused, 'o_dwo_tree_folder': row.folder, 'o_dwo_tree_muted': row.info.muted }"
                         t-att-data-tree-id="row.id" role="treeitem" t-att-aria-level="row.level + 1"
                         t-att-aria-expanded="row.ariaExpanded"
                         t-att-aria-setsize="row.setsize" t-att-aria-posinset="row.posinset" aria-selected="false"
                         t-att-tabindex="row.focused ? 0 : -1" t-att-title="row.info.title or row.info.name"
                         t-attf-style="transform: translateY({{ row.top }}px);"
                         t-on-click="(ev) => this.onRowClick(ev, row.id)">
                        <span class="o_dwo_tree_col_name" t-attf-style="padding-left: {{ 6 + row.level * 18 }}px;">
                            <i t-if="row.folder" class="o_dwo_tree_chevron fa" t-att-class="row.expanded ? 'fa-caret-down' : 'fa-caret-right'" aria-hidden="true"/>
                            <span t-else="" class="o_dwo_tree_chevron"/>
                            <img class="o_dwo_tree_icon" alt="" t-att-src="row.folder ? props.folderIcon(row.expanded) : row.info.icon"/>
                            <span class="o_dwo_tree_name" t-esc="row.info.name"/>
                            <span t-if="row.folder" class="o_dwo_tree_count" t-esc="row.info.count"/>
                        </span>
                        <span class="o_dwo_tree_col_size" t-esc="row.info.size"/>
                        <span class="o_dwo_tree_col_date" t-esc="row.info.date"/>
                        <span class="o_dwo_tree_col_act">
                            <button t-if="!row.folder and props.onDownload and !row.info.muted" type="button"
                                    class="btn btn-link btn-sm o_dwo_tree_download" t-att-title="'Download ' + row.info.name"
                                    aria-label="Download" t-on-click.stop="() => props.onDownload(row.id)">
                                <i class="fa fa-download" aria-hidden="true"/>
                            </button>
                        </span>
                    </div>
                </div>
            </div>
        </div>
    </t>

    <t t-name="dwo_attpreview_archive.ArchiveViewer">
        <div class="o_dwo_arc" t-ref="tree">
            <div class="o_dwo_arc_bar">
                <span class="badge text-bg-secondary o_dwo_arc_format" t-esc="summary.format"/>
                <span class="o_dwo_arc_stats">
                    <t t-esc="summary.files"/> files, <t t-esc="summary.folders"/> folders, <t t-esc="summary.size"/>
                    <span class="text-muted ms-1">(archive <t t-esc="summary.packed"/>)</span>
                </span>
                <div class="o_dwo_arc_tools">
                    <div class="o_dwo_arc_search">
                        <i class="fa fa-search" aria-hidden="true"/>
                        <input type="search" class="form-control form-control-sm o_dwo_arc_filter" placeholder="Filter by name"
                               aria-label="Filter by name" t-on-input="onFilterInput"/>
                    </div>
                    <span t-if="ui.filter" class="o_dwo_arc_matches text-muted"><t t-esc="ui.matchCount"/> found</span>
                    <button type="button" class="btn btn-link btn-sm" t-att-disabled="!canExpandAll"
                            t-att-title="canExpandAll ? 'Expand all' : 'Too many folders to expand all'" t-on-click="expandAll">Expand all</button>
                    <button type="button" class="btn btn-link btn-sm" t-on-click="collapseAll">Collapse all</button>
                </div>
            </div>
            <div t-if="data.truncated" class="o_dwo_arc_note alert alert-warning mb-0">
                Very large archive: only the first <t t-esc="summary.files"/> files are listed.
            </div>
            <div t-if="data.extract_hint" class="o_dwo_arc_note alert alert-info mb-0" t-esc="data.extract_hint"/>
            <div t-if="data.encrypted" class="o_dwo_arc_note alert alert-secondary mb-0">
                <t t-esc="data.encrypted"/> file(s) are protected by a password and cannot be opened.
            </div>
            <DwoTreeView rootId="'d0'" label="'Files of the archive'" version="ui.version" expanded="initialExpanded"
                         getChildren.bind="getChildren" isFolder.bind="isFolder" row.bind="row" onOpen.bind="onOpen"
                         onDownload.bind="onDownload" onReady.bind="onTreeReady" folderIcon.bind="folderIcon"/>
            <div t-if="ui.filter and !ui.matchCount" class="o_dwo_arc_empty text-muted">No file name contains this text.</div>
        </div>
    </t>
</templates>
