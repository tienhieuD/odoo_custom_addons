<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_dwo_ai_dataset_wizard" model="ir.ui.view">
        <field name="name">dwo.ai.dataset.wizard.form</field>
        <field name="model">dwo.ai.dataset.wizard</field>
        <field name="arch" type="xml">
            <form string="Ask the assistant for a dataset">
                <p class="text-muted">
                    What is sent to the AI service: the format of a dataset, the names and kinds of the fields of the models you choose (or the
                    columns of the tables, never those that look like credentials), your request, the current definition only if you tick the box,
                    and the identifier of this database. No record is ever sent. The answer is only a proposal: it is written to the dataset when
                    you press <b>Use it</b>, and you can then check it and test it as usual.
                </p>
                <group>
                    <field name="kind" readonly="dataset_id"/>
                    <field name="dataset_id" options="{'no_create': True}" domain="[('kind', '=', kind)]"/>
                    <field name="model_ids" widget="many2many_tags" options="{'no_create': True}" invisible="kind == 'sql'"
                           required="kind == 'blend'" readonly="dataset_id and kind == 'orm'"/>
                    <field name="tables" invisible="kind != 'sql'" placeholder="sale_order, res_partner"/>
                    <field name="send_current" invisible="not dataset_id or kind == 'orm'"/>
                </group>
                <field name="request" placeholder="For example: revenue of the confirmed sales and the amount of the purchases, by month"/>
                <div class="alert alert-danger" invisible="not message"><field name="message" nolabel="1"/></div>
                <group invisible="not result_text">
                    <field name="result_text" widget="text" nolabel="1" colspan="2"/>
                </group>
                <field name="result_json" invisible="1"/>
                <footer>
                    <button string="Ask" type="object" name="action_ask" class="btn-primary" data-hotkey="q"/>
                    <button string="Use it" type="object" name="action_apply" class="btn-primary" invisible="not result_json"/>
                    <button string="Close" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
    <record id="action_dwo_ai_dataset" model="ir.actions.act_window">
        <field name="name">Ask the assistant for a dataset</field>
        <field name="res_model">dwo.ai.dataset.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
    <record id="view_dwo_dataset_list" model="ir.ui.view">
        <field name="name">dwo.dataset.list</field>
        <field name="model">dwo.dataset</field>
        <field name="arch" type="xml">
            <list js_class="dwo_dataset_list">
                <field name="label"/>
                <field name="kind"/>
                <field name="ref"/>
            </list>
        </field>
    </record>
    <record id="view_dwo_dataset_form" model="ir.ui.view">
        <field name="name">dwo.dataset.form</field>
        <field name="model">dwo.dataset</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_check" type="object" string="Check" class="btn-primary" invisible="kind == 'orm'"
                            help="Checks the definition with your own access rights."/>
                    <button name="action_test" type="object" string="Test the query" invisible="kind != 'sql'"
                            help="Runs the query (20 rows) with every protection and shows what it returns."/>
                    <button name="action_fill_columns" type="object" string="Fill the columns from the query" invisible="kind != 'sql'"
                            help="Lists the columns the query returns; you only choose which are dimensions and which are measures."/>
                    <button name="%(action_dwo_ai_dataset)d" type="action" string="Ask AI" invisible="not id"
                            context="{'default_dataset_id': id, 'default_kind': kind}"
                            help="Describe what you want; the assistant proposes a definition that you review before using it."/>
                </header>
                <sheet>
                    <group>
                        <field name="kind" readonly="id"/>
                        <field name="model_id" options="{'no_create': True}" invisible="kind != 'orm'" required="kind == 'orm'"/>
                        <field name="code" invisible="kind == 'orm'" required="kind != 'orm'" readonly="id"/>
                        <field name="label"/>
                        <field name="model_name" invisible="1"/>
                    </group>
                    <div invisible="kind != 'blend'" class="alert alert-info">
                        <p class="mb-1"><b>A blend</b> reads two or three Odoo models one by one, each with the rights of the person who looks at the
                        dashboard, and merges the results by the dimensions they share (for example the month, the customer): revenue from the sales
                        and spending from the purchases on the same axis. It joins grouped results, not records one by one.</p>
                        <pre class="mb-0 small">{"schema": "dwo-dataset/1", "type": "blend", "code": "sales_vs_purchases", "label": "Sales and purchases",
 "sources": [{"name": "sales", "dataset": "orm:sale.order"}, {"name": "buy", "dataset": "orm:purchase.order"}],
 "dimensions": [{"name": "month", "label": "Date", "kind": "date", "map": {"sales": "date_order", "buy": "date_order"}}],
 "metrics": [{"name": "revenue", "source": "sales", "agg": "sum", "field": "amount_total", "label": "Revenue"},
             {"name": "spend", "source": "buy", "agg": "sum", "field": "amount_total", "label": "Purchases"}]}</pre>
                    </div>
                    <div invisible="kind != 'sql'" class="alert alert-warning">
                        <p class="mb-1"><b>A SQL dataset ignores the record rules of Odoo.</b> Everybody who can open a page that uses it sees what the
                        query returns, whoever they are in Odoo (limited to the groups in <b>Who can use it</b>, by default every dashboard user).
                        Write it with that in mind: no data that a person should not see.</p>
<pre class="mb-0 small">SELECT user_id AS person, date_order::date AS day, amount_total AS total
FROM sale_order WHERE state IN ('sale', 'done')</pre>
                        <p class="mt-2 mb-0">Write the query, choose who can use it, save, then press <b>Fill the columns from the query</b>: the
                        columns are written from what the query returns and you only choose which are dimensions and which are measures.</p>
                    </div>
                    <field name="definition_text" widget="ace" options="{'mode': 'json'}" nolabel="1" invisible="kind != 'blend'"/>
                    <group invisible="kind != 'sql'">
                        <field name="sql_group_ids" widget="many2many_tags" options="{'no_create': True}"/>
                    </group>
                    <label for="sql_query" invisible="kind != 'sql'"/>
                    <field name="sql_query" widget="ace" options="{'mode': 'sql'}" invisible="kind != 'sql'"/>
                    <label for="sql_options" invisible="kind != 'sql'"/>
                    <field name="sql_options" widget="ace" options="{'mode': 'json'}" invisible="kind != 'sql'"/>
                    <separator string="Metrics" invisible="kind != 'orm'"/>
                    <p class="text-muted" invisible="kind != 'orm'">
                        A metric is a named measure that dashboards can use (for example <i>won_revenue</i>: the sum of the amount of the
                        confirmed orders). It always runs with the access rights of the person who looks at the dashboard.
                    </p>
                    <field name="metric_ids" invisible="kind != 'orm'">
                        <list editable="bottom">
                            <field name="sequence" widget="handle"/>
                            <field name="model_name" column_invisible="1"/>
                            <field name="name"/>
                            <field name="label"/>
                            <field name="agg"/>
                            <field name="field_id" options="{'no_create': True}"/>
                            <field name="where" widget="domain" options="{'model': 'model_name'}"/>
                            <field name="format"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_dwo_dataset" model="ir.actions.act_window">
        <field name="name">Datasets and metrics</field>
        <field name="res_model">dwo.dataset</field>
        <field name="view_mode">list,form</field>
    </record>
    <menuitem id="menu_dwo_config" name="Configuration" parent="menu_dwo_dashboard" sequence="90" groups="group_dwo_dashboard_manager"/>
    <menuitem id="menu_dwo_dataset" name="Datasets and metrics" parent="menu_dwo_config" action="action_dwo_dataset" sequence="10"/>
    <record id="view_dwo_ai_config" model="ir.ui.view">
        <field name="name">dwo.ai.config.form</field>
        <field name="model">dwo.ai.config</field>
        <field name="arch" type="xml">
            <form string="AI assistant">
                <p class="text-muted px-3 pt-3">
                    The assistant turns a request into a change of the page, which the person reviews before saving. What is sent to the
                    service: the format of a page, the names of the fields that person can read, the metrics, the page (its titles and the
                    values of its conditions), the request and the identifier of this database. No record is ever sent.
                </p>
                <group>
                    <field name="enabled"/>
                    <field name="provider"/>
                    <field name="endpoint" invisible="provider != 'openai'"/>
                    <field name="model" invisible="provider != 'openai'"/>
                    <field name="api_key" password="True" invisible="provider != 'openai'"/>
                    <field name="key_set" invisible="provider != 'openai'"/>
                </group>
                <footer>
                    <button string="Save" type="object" name="action_save" class="btn-primary"/>
                    <button string="Discard" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
    <record id="action_dwo_ai_settings" model="ir.actions.act_window">
        <field name="name">AI assistant</field>
        <field name="res_model">dwo.ai.config</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
    <menuitem id="menu_dwo_ai_settings" name="AI assistant" parent="menu_dwo_config" action="action_dwo_ai_settings" sequence="20"/>
</odoo>
