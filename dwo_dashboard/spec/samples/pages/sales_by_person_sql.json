{
  "schema": "dwo-dashboard/1",
  "title": "Sales by salesperson (SQL dataset)",
  "grid": {"cols": 12},
  "filters": [
    {"id": "period", "type": "date", "label": "Order date", "default": "this_year",
     "bind": [{"dataset": "sql:sales_by_person", "field": "order_date"}]}
  ],
  "widgets": [
    {"id": "orders", "type": "kpi", "title": "Orders", "x": 0, "y": 0, "w": 3, "h": 2,
     "dataset": "sql:sales_by_person", "wells": {"value": {"metric": "orders"}}},
    {"id": "revenue", "type": "kpi", "title": "Revenue", "x": 3, "y": 0, "w": 3, "h": 2,
     "dataset": "sql:sales_by_person", "wells": {"value": {"metric": "revenue_total"}},
     "options": {"format": "currency", "decimals": 0}},
    {"id": "by_person", "type": "bar", "title": "Revenue by salesperson", "x": 6, "y": 0, "w": 6, "h": 4,
     "dataset": "sql:sales_by_person",
     "wells": {"axis": {"field": "salesperson"}, "values": [{"metric": "revenue_total"}]},
     "order": [{"measure": "revenue_total", "dir": "desc"}], "limit": 10, "options": {"horizontal": true}},
    {"id": "trend", "type": "line", "title": "Revenue per month", "x": 0, "y": 2, "w": 6, "h": 4,
     "dataset": "sql:sales_by_person",
     "wells": {"axis": {"field": "order_date", "interval": "month"}, "values": [{"metric": "revenue_total"}]},
     "order": [{"field": "order_date", "dir": "asc"}], "limit": 24}
  ]
}
