{
  "schema": "dwo-dashboard/1",
  "title": "Sales",
  "description": "Needs the Sales app. The second chart groups through a relation (Odoo 19 and later).",
  "grid": {"cols": 12},
  "filters": [
    {"id": "period", "type": "date", "label": "Order date", "default": "this_quarter",
     "bind": [{"dataset": "orm:sale.order", "field": "date_order"}]}
  ],
  "widgets": [
    {"id": "revenue", "type": "kpi", "title": "Revenue", "x": 0, "y": 0, "w": 3, "h": 2,
     "dataset": "orm:sale.order", "wells": {"value": {"metric": "revenue"}},
     "options": {"format": "currency", "decimals": 0}},
    {"id": "orders", "type": "kpi", "title": "Orders", "x": 3, "y": 0, "w": 3, "h": 2,
     "dataset": "orm:sale.order", "wells": {"value": {"metric": "orders"}}},
    {"id": "monthly", "type": "bar", "title": "Revenue per month and salesperson", "x": 6, "y": 0, "w": 6, "h": 4,
     "dataset": "orm:sale.order",
     "wells": {"axis": {"field": "date_order", "interval": "month"}, "legend": {"field": "user_id"},
               "values": [{"metric": "revenue"}]},
     "order": [{"field": "date_order", "dir": "asc"}], "limit": 12, "series_limit": 8,
     "options": {"stacked": true, "legend": "bottom"}},
    {"id": "by_category", "type": "bar", "title": "Revenue by product category", "x": 0, "y": 4, "w": 12, "h": 4,
     "dataset": "orm:sale.order.line", "where": [["state", "in", ["sale", "done"]]],
     "wells": {"axis": {"field": "product_id.categ_id"},
               "values": [{"field": "price_subtotal", "agg": "sum", "label": "Revenue"}]},
     "order": [{"measure": "price_subtotal:sum", "dir": "desc"}], "limit": 15, "options": {"horizontal": true}},
    {"id": "top", "type": "table", "title": "Biggest orders", "x": 0, "y": 8, "w": 12, "h": 5,
     "dataset": "orm:sale.order", "where": [["state", "in", ["sale", "done"]]],
     "wells": {"columns": [{"field": "name"}, {"field": "partner_id"}, {"field": "date_order"},
                           {"field": "amount_total"}]},
     "order": [{"field": "amount_total", "dir": "desc"}], "limit": 10}
  ]
}
