{
  "schema": "dwo-dashboard/1",
  "title": "Partners overview",
  "description": "Contacts by country and by month of creation, with the latest companies.",
  "grid": {"cols": 12},
  "filters": [
    {"id": "created", "type": "date", "label": "Created", "default": "this_year",
     "bind": [{"dataset": "orm:res.partner", "field": "create_date"}]},
    {"id": "country", "type": "relation", "label": "Country", "model": "res.country",
     "bind": [{"dataset": "orm:res.partner", "field": "country_id"}]}
  ],
  "widgets": [
    {"id": "total", "type": "kpi", "title": "Contacts", "x": 0, "y": 0, "w": 3, "h": 2,
     "dataset": "orm:res.partner", "wells": {"value": {"metric": "contacts"}}},
    {"id": "companies", "type": "kpi", "title": "Companies", "x": 3, "y": 0, "w": 3, "h": 2,
     "dataset": "orm:res.partner", "wells": {"value": {"metric": "companies"}}},
    {"id": "by_country", "type": "bar", "title": "Top countries", "x": 6, "y": 0, "w": 6, "h": 4,
     "dataset": "orm:res.partner",
     "wells": {"axis": {"field": "country_id"}, "values": [{"agg": "count", "label": "Contacts"}]},
     "order": [{"measure": "__count", "dir": "desc"}], "limit": 10,
     "options": {"horizontal": true, "legend": "none"}},
    {"id": "by_month", "type": "line", "title": "New contacts per month", "x": 0, "y": 2, "w": 6, "h": 4,
     "dataset": "orm:res.partner",
     "wells": {"axis": {"field": "create_date", "interval": "month"}, "values": [{"agg": "count"}]},
     "order": [{"field": "create_date", "dir": "asc"}], "limit": 24, "options": {"smooth": true}},
    {"id": "kind", "type": "doughnut", "title": "Companies and people", "x": 6, "y": 4, "w": 3, "h": 4,
     "dataset": "orm:res.partner",
     "wells": {"category": {"field": "is_company"}, "value": {"agg": "count"}},
     "options": {"legend": "bottom"}},
    {"id": "matrix", "type": "pivot", "title": "Country by quarter", "x": 0, "y": 6, "w": 6, "h": 5,
     "dataset": "orm:res.partner",
     "wells": {"rows": [{"field": "country_id"}], "columns": [{"field": "create_date", "interval": "quarter"}],
               "values": [{"agg": "count"}]},
     "options": {"show_totals": true}},
    {"id": "mine", "type": "table", "title": "Contacts I created", "x": 6, "y": 8, "w": 6, "h": 3,
     "dataset": "orm:res.partner", "where": [["create_uid", "=", {"ctx": "uid"}]],
     "wells": {"columns": [{"field": "name"}, {"field": "create_date"}]},
     "order": [{"field": "create_date", "dir": "desc"}], "limit": 5},
    {"id": "latest", "type": "table", "title": "Latest contacts", "x": 0, "y": 11, "w": 12, "h": 5,
     "dataset": "orm:res.partner", "where": [["active", "=", true]],
     "wells": {"columns": [{"field": "name"}, {"field": "email"}, {"field": "country_id", "label": "Country"},
                           {"field": "create_date"}]},
     "order": [{"field": "create_date", "dir": "desc"}], "limit": 20}
  ]
}
