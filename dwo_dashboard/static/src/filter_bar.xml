<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="dwo_dashboard.FilterBar">
        <div class="dwo-filter-bar d-flex flex-wrap align-items-center gap-2">
            <div t-foreach="props.filters" t-as="flt" t-key="flt.id" class="dwo-filter d-flex align-items-center gap-1"
                 t-att-data-filter-id="flt.id">
                <span class="text-muted" t-out="label(flt)"/>
                <a t-if="props.editing" href="#" class="text-danger small dwo-filter-remove" title="Remove this filter"
                   t-on-click.prevent="() => props.onRemove(flt)">×</a>
                <DwoSelect t-if="flt.type === 'date'" class="'w-auto'" options="presetOptions" value="presetOf(flt)" onChange.bind="setPreset" args="[flt]"/>
                <div t-elif="flt.type === 'selection'" class="d-flex flex-wrap gap-1">
                    <button t-foreach="flt.values" t-as="value" t-key="value" type="button"
                            t-attf-class="btn btn-sm #{selectionValue(flt).includes(value) ? 'btn-primary' : 'btn-secondary'}"
                            t-on-click="() => this.toggleValue(flt, value)" t-out="value"/>
                </div>
                <div t-else="" class="d-flex flex-wrap align-items-center gap-1 position-relative">
                    <span t-foreach="chips(flt)" t-as="chip" t-key="chip.id" class="badge text-bg-secondary">
                        <t t-out="chip.name"/>
                        <a href="#" class="text-reset ms-1" t-on-click.prevent="() => this.unpick(flt, chip)">×</a>
                    </span>
                    <button type="button" class="btn btn-sm btn-secondary dwo-filter-open" t-on-click="(ev) => this.open(flt, ev)">
                        <t t-if="chips(flt).length">+</t><t t-else="">All <i class="fa fa-caret-down"/></t>
                    </button>
                    <div t-if="state.openId === flt.id" class="dwo-filter-menu dwo-fixed-menu card p-2" t-att-style="state.style">
                        <input class="form-control form-control-sm mb-1" placeholder="Search..." t-att-value="state.query"
                               t-on-input="(ev) => this.search(flt, ev.target.value)"/>
                        <div t-foreach="state.options" t-as="option" t-key="option.id" class="dwo-filter-option"
                             t-on-click="() => this.pick(flt, option)" t-out="option.name"/>
                    </div>
                </div>
            </div>
        </div>
    </t>
</templates>
