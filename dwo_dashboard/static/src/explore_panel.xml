<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="dwo_dashboard.ExplorePanel">
        <div class="dwo-explore d-flex flex-column h-100">
            <div class="dwo-explore-head d-flex align-items-center gap-2 px-3 py-2 border-bottom">
                <h5 class="mb-0 flex-grow-1"><t t-if="props.widget">Edit widget</t><t t-else="">Add a widget</t></h5>
                <button class="btn btn-sm btn-outline-secondary dwo-explore-close" t-on-click="props.onClose">Close</button>
            </div>

            <!-- the result stays in view while the choices are made below -->
            <div class="dwo-explore-preview border-bottom">
                <div t-if="!complete" class="dwo-explore-hint d-flex h-100 align-items-center justify-content-center text-muted text-center px-4">
                    <span t-if="!state.dataset">Start by choosing the data you want to look at.</span>
                    <span t-else="">Choose the fields below to see the result.</span>
                </div>
                <WidgetCard t-else="" widget="previewWidget" entry="state.preview.entry or {loading: true}"/>
            </div>

            <div class="dwo-explore-body flex-grow-1 overflow-auto p-3">
                <div class="mb-3 position-relative">
                    <label class="form-label fw-bold">Data</label>
                    <input class="form-control dwo-dataset-input" placeholder="Search: Contact, Sales order, Invoice..."
                           t-att-value="state.datasetOpen ? state.search : datasetLabel"
                           t-on-focus="openDatasets" t-on-blur="closeDatasets" t-on-input="(ev) => state.search = ev.target.value"/>
                    <div t-if="state.datasetOpen" class="dwo-dataset-list dwo-fixed-menu card shadow" t-att-style="state.datasetStyle">
                        <t t-foreach="datasetChoices" t-as="d" t-key="d.ref">
                            <div t-if="d_index === 0 or datasetChoices[d_index - 1].group !== d.group" class="dwo-dataset-group small text-muted px-2 pt-1"
                                 t-out="groupTitle(d.group)"/>
                            <div class="dwo-dataset-option px-2 py-1" t-on-mousedown.prevent="() => this.pickDataset(d)">
                                <span t-out="d.label"/> <span class="text-muted small" t-out="d.model"/>
                            </div>
                        </t>
                        <div t-if="!datasetChoices.length" class="px-2 py-1 text-muted">Nothing found.</div>
                    </div>
                </div>

                <t t-if="state.dataset">
                    <div class="mb-3">
                        <label class="form-label fw-bold">Show it as</label>
                        <div class="dwo-visuals d-flex flex-wrap gap-2">
                            <button t-foreach="visualTypes" t-as="v" t-key="v.name" type="button"
                                    t-attf-class="dwo-visual dwo-visual-#{v.name} #{state.type === v.name ? 'active' : ''}"
                                    t-on-click="() => this.setType(v.name)">
                                <i t-attf-class="fa #{visualIcon(v.name)} fa-lg"/>
                                <span t-out="v.label"/>
                            </button>
                        </div>
                        <div t-if="hint" class="small mt-1">
                            Dates on the axis? Try
                            <a href="#" t-on-click.prevent="() => this.setType(hint)" t-out="state.visuals[hint].label"/>.
                        </div>
                    </div>

                    <div t-foreach="wellList" t-as="well" t-key="well.name" class="mb-3 dwo-well" t-att-data-well="well.name">
                        <label class="form-label fw-bold text-capitalize" t-out="well.name"/>
                        <div t-foreach="items(well)" t-as="item" t-key="item_index" class="d-flex gap-1 mb-1 dwo-well-item">
                            <t t-if="well.accepts === 'measure'">
                                <DwoSelect class="'w-auto dwo-agg-select'" options="aggOptions" value="aggValue(item)" onChange.bind="setAgg" args="[item]"/>
                                <DwoSelect t-if="!item.metric and item.agg !== 'count'" options="fieldOptions(well, item)" value="item.field" placeholder="'Field...'" onChange.bind="setField" args="[item]"/>
                            </t>
                            <t t-else="">
                                <DwoSelect t-foreach="levels(well, item)" t-as="lv" t-key="lv.level" class="'dwo-field-select'" dataLevel="lv.level" options="lv.options" value="lv.selected" placeholder="'Choose a field...'" onChange.bind="pick" args="[item, lv.level]"/>
                                <DwoSelect t-if="well.accepts === 'dimension' and isDate(item)" class="'w-auto'" options="intervalOptions" value="item.interval" onChange.bind="setInterval" args="[item]"/>
                            </t>
                            <button t-if="canRemove(well)" type="button" class="btn btn-sm btn-link text-danger px-1"
                                    t-on-click="() => this.removeItem(well, item_index)" title="Remove">×</button>
                        </div>
                        <button t-if="canAdd(well)" type="button" class="btn btn-sm btn-link px-0 dwo-add-item"
                                t-on-click="() => this.addItem(well)">+ Add<t t-if="well.accepts === 'measure'"> another value</t><t t-else=""> a field</t></button>
                    </div>

                    <div t-if="canCompare" class="mb-3 dwo-compare">
                        <label class="form-check d-flex align-items-center gap-2 mb-1">
                            <input type="checkbox" class="form-check-input mt-0 dwo-compare-toggle" t-att-checked="state.compare.enabled"
                                   t-on-change="toggleCompare"/>
                            <span class="fw-bold"><t t-if="compareOnAxis">Draw the previous period over the chart</t><t t-else="">Show the change since the previous period</t></span>
                        </label>
                        <div t-if="state.compare.enabled" class="row g-2">
                            <div t-if="!compareOnAxis" class="col-6">
                                <label class="form-label small">Date</label>
                                <DwoSelect options="dateFieldOptions" value="state.compare.field" onChange.bind="setCompare" args="['field']"/>
                            </div>
                            <div class="col-6">
                                <label class="form-label small">Compared with</label>
                                <DwoSelect options="againstOptions" value="state.compare.against" onChange.bind="setCompare" args="['against']"/>
                            </div>
                            <div class="col-12">
                                <label class="form-label small">Period</label>
                                <DwoSelect options="periodOptions" value="state.compare.period" onChange.bind="setCompare" args="['period']"/>
                                <div class="form-text">If the page has a date filter on this date, its period is used instead.</div>
                            </div>
                        </div>
                    </div>

                    <div t-if="vdef and vdef.trend and dateFields.length" class="mb-3 dwo-trend">
                        <label class="form-check d-flex align-items-center gap-2 mb-1">
                            <input type="checkbox" class="form-check-input mt-0 dwo-trend-toggle" t-att-checked="state.trend.enabled"
                                   t-on-change="toggleTrend"/>
                            <span class="fw-bold">Draw a small trend line</span>
                        </label>
                        <div t-if="state.trend.enabled" class="row g-2">
                            <div class="col-6">
                                <label class="form-label small">Date</label>
                                <DwoSelect options="dateFieldOptions" value="state.trend.field" onChange.bind="setTrend" args="['field']"/>
                            </div>
                            <div class="col-3">
                                <label class="form-label small">Per</label>
                                <DwoSelect options="trendIntervalOptions" value="state.trend.interval" onChange.bind="setTrend" args="['interval']"/>
                            </div>
                            <div class="col-3">
                                <label class="form-label small">Points</label>
                                <input type="number" min="3" max="60" class="form-control form-control-sm" t-att-value="state.trend.points"
                                       t-on-input="(ev) => this.setTrend('points', ev)"/>
                            </div>
                        </div>
                    </div>

                    <div class="mb-3">
                        <button type="button" class="btn btn-sm btn-link px-0" t-on-click="() => state.showFilter = !state.showFilter">
                            <i class="fa fa-filter"/> Only some records <t t-if="state.where.length">(<t t-out="state.where.length"/>)</t>
                        </button>
                        <div t-if="state.showFilter and state.model" class="mt-2">
                            <DomainSelector resModel="state.model" domain="domainString" readonly="false" update.bind="onDomain"/>
                        </div>
                    </div>

                    <div class="dwo-options row g-2 mb-3">
                        <div class="col-6" t-if="vdef and vdef.limit">
                            <label class="form-label small">How many</label>
                            <input type="number" min="1" class="form-control form-control-sm" t-att-placeholder="vdef.limit.default"
                                   t-att-max="vdef.limit.max" t-model="state.limit" t-on-input="schedulePreview"/>
                        </div>
                        <div class="col-6">
                            <label class="form-label small">Sort by</label>
                            <DwoSelect options="orderOptions" value="state.orderKey" onChange.bind="setOrderKey"/>
                        </div>
                        <div class="col-12">
                            <label class="form-label small">Icon and title</label>
                            <div class="input-group input-group-sm position-relative">
                                <button type="button" class="btn btn-secondary dwo-icon-button" title="Choose the icon"
                                        t-on-click="(ev) => this.toggleIconMenu(ev)"><i t-attf-class="fa #{currentIcon}"/></button>
                                <input class="form-control dwo-title-input" t-att-placeholder="autoTitle" t-model="state.title"/>
                                <div t-if="state.iconMenu" class="dwo-icon-menu dwo-fixed-menu card shadow p-2" t-att-style="state.iconStyle">
                                    <div class="d-flex flex-wrap gap-1">
                                        <button t-foreach="iconChoices" t-as="ic" t-key="ic" type="button" t-att-title="ic"
                                                t-attf-class="btn btn-sm dwo-icon-choice #{ic === currentIcon ? 'btn-primary' : 'btn-light'}"
                                                t-on-click="() => this.setIcon(ic)"><i t-attf-class="fa #{ic}"/></button>
                                    </div>
                                    <a href="#" class="small mt-2 d-block dwo-icon-default" t-on-click.prevent="() => this.setIcon('')">Use the default icon of this type</a>
                                </div>
                            </div>
                        </div>
                        <div t-foreach="optionList" t-as="opt" t-key="opt.name" t-attf-class="#{opt.kind === 'bool' ? 'col-12' : 'col-6'}">
                            <label t-if="opt.kind === 'bool'" class="form-check d-flex align-items-center gap-2 mb-0">
                                <input type="checkbox" class="form-check-input mt-0" t-att-checked="state.options[opt.name]"
                                       t-on-change="(ev) => this.setOption(opt.name, opt, ev)"/>
                                <span class="small" t-out="optionLabel(opt.name)"/>
                            </label>
                            <t t-else="">
                                <label class="form-label small" t-out="optionLabel(opt.name)"/>
                                <DwoSelect t-if="opt.kind === 'enum'" options="enumOptions(opt)" value="state.options[opt.name] || ''" onChange.bind="setOption" args="[opt.name, opt]"/>
                                <input t-elif="opt.kind === 'int' or opt.kind === 'number'" type="number" class="form-control form-control-sm"
                                       t-att-min="opt.min" t-att-max="opt.max" t-att-value="state.options[opt.name]"
                                       t-on-input="(ev) => this.setOption(opt.name, opt, ev)"/>
                                <input t-elif="opt.kind === 'text'" class="form-control form-control-sm" t-att-maxlength="opt.max"
                                       t-att-value="state.options[opt.name]" t-on-input="(ev) => this.setOption(opt.name, opt, ev)"/>
                            </t>
                        </div>
                    </div>
                </t>
            </div>
            <div class="dwo-explore-foot p-3 border-top d-flex justify-content-end gap-2">
                <button class="btn btn-secondary" t-on-click="props.onClose">Cancel</button>
                <button class="btn btn-primary dwo-explore-apply" t-att-disabled="!complete or (state.preview.entry and state.preview.entry.error)"
                        t-on-click="apply"><t t-if="props.widget">Update widget</t><t t-else="">Add to page</t></button>
            </div>
        </div>
    </t>
</templates>
