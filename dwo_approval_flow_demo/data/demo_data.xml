<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="user_alice" model="res.users" context="{'no_reset_password': True}">
        <field name="name">Alice Martin</field>
        <field name="login">demo_alice</field>
        <field name="password">demo</field>
        <field name="email">alice@example.com</field>
        <field name="group_ids" eval="[(6, 0, [ref('base.group_user'), ref('purchase.group_purchase_user')])]"/>
    </record>
    <record id="user_bob" model="res.users" context="{'no_reset_password': True}">
        <field name="name">Bob Carter</field>
        <field name="login">demo_bob</field>
        <field name="password">demo</field>
        <field name="email">bob@example.com</field>
        <field name="group_ids" eval="[(6, 0, [ref('base.group_user'), ref('purchase.group_purchase_manager')])]"/>
    </record>
    <record id="user_carol" model="res.users" context="{'no_reset_password': True}">
        <field name="name">Carol Evans</field>
        <field name="login">demo_carol</field>
        <field name="password">demo</field>
        <field name="email">carol@example.com</field>
        <field name="group_ids" eval="[(6, 0, [ref('base.group_user'), ref('purchase.group_purchase_manager')])]"/>
    </record>

    <record id="vendor_gemini" model="res.partner">
        <field name="name">Gemini Furniture</field>
    </record>
    <record id="vendor_acme" model="res.partner">
        <field name="name">Acme Supplies</field>
    </record>

    <record id="product_chair" model="product.product">
        <field name="name">Office Chair</field>
        <field name="list_price">120</field>
        <field name="standard_price">100</field>
    </record>
    <record id="product_desk" model="product.product">
        <field name="name">Standing Desk</field>
        <field name="list_price">450</field>
        <field name="standard_price">400</field>
    </record>
    <record id="product_lamp" model="product.product">
        <field name="name">Desk Lamp</field>
        <field name="list_price">80</field>
        <field name="standard_price">60</field>
    </record>
</odoo>
