<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="dwo_listview_header_filter.Button">
        <button type="button" class="o_dwo_hf_btn btn btn-link p-0 ms-1" t-att-class="{ o_dwo_hf_active: active }"
                t-att-data-dwo-hf="props.column.name" t-att-title="title" t-att-aria-pressed="active ? 'true' : 'false'"
                t-on-click.stop="onClick" t-on-pointerup.stop="swallow" t-on-pointerdown.stop="swallow" t-on-dblclick.stop="swallow">
            <i class="fa fa-filter" role="img"/>
        </button>
    </t>

    <t t-name="dwo_listview_header_filter.Popover">
        <div class="o_dwo_hf" t-att-data-kind="props.kind" t-on-keydown="onKeydown">
            <div class="o_dwo_hf_title" t-esc="props.field.string or props.field.name"/>

            <!-- text and number -->
            <t t-if="props.kind === 'text' or props.kind === 'number'">
                <div class="o_dwo_hf_body">
                    <select class="form-select form-select-sm o_dwo_hf_op" t-on-change="onOperator" t-att-value="state.op">
                        <option t-foreach="operators" t-as="op" t-key="op.id" t-att-value="op.id" t-att-selected="op.id === state.op" t-esc="op.label"/>
                    </select>
                    <t t-if="operator.needsValue">
                        <input t-if="props.kind === 'number'" type="number" t-att-step="numberStep" class="form-control form-control-sm mt-2 o_dwo_hf_value"
                               t-ref="input" t-att-value="state.value" t-on-input="onValue" t-att-placeholder="operator.range ? _t('From') : _t('Value')"/>
                        <input t-else="" type="text" class="form-control form-control-sm mt-2 o_dwo_hf_value" t-ref="input"
                               t-att-value="state.value" t-on-input="onValue" placeholder="Value"/>
                        <input t-if="operator.range" type="number" t-att-step="numberStep" class="form-control form-control-sm mt-2 o_dwo_hf_value2"
                               t-att-value="state.value2" t-on-input="onValue2" placeholder="To"/>
                    </t>
                </div>
            </t>

            <!-- boolean -->
            <div t-elif="props.kind === 'boolean'" class="o_dwo_hf_body o_dwo_hf_bool">
                <button type="button" class="btn btn-sm" t-att-class="state.value === true ? 'btn-primary' : 'btn-outline-secondary'" t-on-click="() => this.chooseBoolean(true)">Yes</button>
                <button type="button" class="btn btn-sm" t-att-class="state.value === false ? 'btn-primary' : 'btn-outline-secondary'" t-on-click="() => this.chooseBoolean(false)">No</button>
            </div>

            <!-- date -->
            <t t-elif="props.kind === 'date'">
                <div class="o_dwo_hf_presets">
                    <button t-foreach="presets" t-as="preset" t-key="preset[0]" type="button" class="o_dwo_hf_preset"
                            t-att-class="{ active: state.preset === preset[0] }" t-att-data-preset="preset[0]"
                            t-on-click="() => this.choosePreset(preset[0])" t-esc="preset[1]"/>
                </div>
                <div class="o_dwo_hf_body o_dwo_hf_dates">
                    <div class="btn-group btn-group-sm w-100" role="group">
                        <button type="button" class="btn" t-att-class="state.mode === 'day' ? 'btn-primary' : 'btn-outline-secondary'" t-on-click="() => this.setMode('day')">A day</button>
                        <button type="button" class="btn" t-att-class="state.mode === 'range' ? 'btn-primary' : 'btn-outline-secondary'" t-on-click="() => this.setMode('range')">Between two days</button>
                    </div>
                    <div class="d-flex gap-2 mt-2">
                        <input type="date" class="form-control form-control-sm o_dwo_hf_from" t-att-value="state.from" t-on-input="(ev) => this.onDate('from', ev)"/>
                        <input t-if="state.mode === 'range'" type="date" class="form-control form-control-sm o_dwo_hf_to" t-att-value="state.to" t-on-input="(ev) => this.onDate('to', ev)"/>
                    </div>
                    <label t-if="canBeNotSet" class="o_dwo_hf_row mt-2">
                        <input type="checkbox" class="form-check-input" t-att-checked="state.notSet" t-on-change="toggleNotSetDate"/> <span>Not set</span>
                    </label>
                </div>
            </t>

            <!-- selection, many2one, many2many -->
            <t t-elif="props.kind === 'choice'">
                <div class="o_dwo_hf_body">
                    <input type="search" class="form-control form-control-sm o_dwo_hf_search" t-ref="input" t-att-value="state.search" t-on-input="onSearch" placeholder="Search..."/>
                </div>
                <div class="o_dwo_hf_list">
                    <div t-if="state.selected.length or state.notSet" class="o_dwo_hf_selected">
                        <label t-if="state.notSet" class="o_dwo_hf_row o_dwo_hf_picked" data-value="__not_set">
                            <input type="checkbox" class="form-check-input" checked="checked" t-on-change="() => { state.notSet = false; }"/> <span class="fst-italic">Not set</span>
                        </label>
                        <label t-foreach="state.selected" t-as="item" t-key="item.value" class="o_dwo_hf_row o_dwo_hf_picked" t-att-data-value="item.value">
                            <input type="checkbox" class="form-check-input" checked="checked" t-on-change="() => this.drop(item.value)"/> <span t-esc="item.label"/>
                        </label>
                    </div>
                    <label t-if="canBeNotSet and !state.notSet" class="o_dwo_hf_row" data-value="__not_set">
                        <input type="checkbox" class="form-check-input" t-on-change="() => { state.notSet = true; }"/> <span class="fst-italic">Not set</span>
                    </label>
                    <label t-foreach="freeOptions" t-as="option" t-key="option.value" class="o_dwo_hf_row" t-att-data-value="option.value">
                        <input type="checkbox" class="form-check-input" t-on-change="() => this.pick(option)"/> <span t-esc="option.label"/>
                    </label>
                    <div t-if="state.loading" class="o_dwo_hf_hint">Loading...</div>
                    <div t-elif="!freeOptions.length and !state.selected.length" class="o_dwo_hf_hint">No value found.</div>
                    <button t-if="state.more" type="button" class="btn btn-link btn-sm o_dwo_hf_more" t-on-click="showMore">Show more</button>
                </div>
            </t>

            <div class="o_dwo_hf_footer" t-if="props.kind !== 'boolean'">
                <button type="button" class="btn btn-primary btn-sm o_dwo_hf_apply" t-att-disabled="!canApply" t-on-click="apply">Apply</button>
                <button type="button" class="btn btn-secondary btn-sm o_dwo_hf_reset" t-att-disabled="!hasFilter" t-on-click="reset">Reset</button>
            </div>
            <div class="o_dwo_hf_footer" t-else="">
                <button type="button" class="btn btn-secondary btn-sm o_dwo_hf_reset" t-att-disabled="!hasFilter" t-on-click="reset">Reset</button>
            </div>
        </div>
    </t>

    <t t-name="dwo_listview_header_filter.ListRenderer" t-inherit="web.ListRenderer" t-inherit-mode="extension">
        <xpath expr="//i[hasclass('o_list_sortable_caret')]" position="after">
            <DwoHeaderFilter t-if="dwoHfEnabled(column)" column="column" list="props.list"/>
        </xpath>
    </t>
</templates>
