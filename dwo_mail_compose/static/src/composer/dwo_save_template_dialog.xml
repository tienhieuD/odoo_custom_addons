<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="dwo_mail_compose.SaveTemplateDialog">
        <Dialog title="'Save as Template'" size="'md'">
            <p class="text-muted">The subject, the message (without the quoted email) and the files become a template for this kind of record. It belongs to you.</p>
            <label class="form-label" for="dwo_template_name">Template name</label>
            <input id="dwo_template_name" t-ref="name" type="text" class="form-control" placeholder="e.g. Quote follow-up" t-model="state.name" t-on-keydown="onKeydown"/>
            <t t-set-slot="footer">
                <button type="button" class="btn btn-primary" t-att-disabled="!state.name.trim() or state.saving" t-on-click="save">Save</button>
                <button type="button" class="btn btn-link" t-on-click="props.close">Cancel</button>
            </t>
        </Dialog>
    </t>
</templates>
