<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-inherit="mail.Chatter" t-inherit-mode="extension">
        <xpath expr="//button[hasclass('o-mail-Chatter-sendMessage')]" position="after">
            <button class="o-mail-Chatter-dwoSendEmail btn text-nowrap me-1"
                    t-att-class="{
                        'btn-primary': this.state.composerType === 'email',
                        'btn-outline-primary': this.state.composerType !== 'email',
                        'active': this.state.composerType === 'email',
                    }"
                    t-att-disabled="!this.state.thread.canPostMessage and this.thread().id"
                    t-on-click="() => this.dwoToggleEmail()">
                Send email<span t-if="this.dwo.hasDraft and this.state.composerType !== 'email'" class="o-dwo-draftDot bg-primary ms-1" title="You have a draft"/>
            </button>
        </xpath>
        <!-- The email form takes the room of the chatter: while it is open the messages, the
             activities and the rest are hidden, and they come back as soon as it is closed. -->
        <xpath expr="//div[hasclass('o-mail-Chatter-content')]" position="attributes">
            <attribute name="t-att-class">{ 'o-dwo-hiddenByEmail': this.state.composerType === 'email' }</attribute>
        </xpath>
        <xpath expr="//Composer" position="attributes">
            <attribute name="t-if">this.state.composerType !== 'email'</attribute>
        </xpath>
        <xpath expr="//Composer" position="after">
            <DwoEmailComposer t-if="this.state.composerType === 'email'"
                              thread="this.state.thread"
                              mode="this.dwo.mode"
                              refMessageId="this.dwo.refMessageId"
                              preferredEmailId="this.dwo.rememberedEmailId"
                              onEmailChange.bind="this.dwoOnEmailChange"
                              onClose.bind="this.dwoOnEmailClose"
                              onSent.bind="this.dwoOnEmailSent"
                              t-key="this.dwo.key"/>
        </xpath>
    </t>
</templates>
