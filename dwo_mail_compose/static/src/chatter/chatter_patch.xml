<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <!-- The Send email button, next to Send message -->
    <t t-inherit="mail.ChatterTopbar" t-inherit-mode="extension" owl="1">
        <xpath expr="//button[hasclass('o_ChatterTopbar_buttonSendMessage')]" position="after">
            <button class="o_ChatterTopbar_button o-mail-Chatter-dwoSendEmail btn text-nowrap me-2"
                    type="button"
                    t-att-class="{
                        'o-active btn-odoo': chatterTopbar.chatter.dwoEmailOpen,
                        'btn-light': !chatterTopbar.chatter.dwoEmailOpen,
                    }"
                    t-att-disabled="!chatterTopbar.chatter.canPostMessage"
                    t-on-click="() => chatterTopbar.chatter.dwoToggleEmail()">
                Send email<span t-if="chatterTopbar.chatter.dwoHasDraft and !chatterTopbar.chatter.dwoEmailOpen" class="o-dwo-draftDot bg-primary ms-1" title="You have a draft"/>
            </button>
        </xpath>
    </t>
    <t t-inherit="mail.Chatter" t-inherit-mode="extension" owl="1">
        <!-- The email form takes the room of the chatter: while it is open the messages, the activities
             and the rest are hidden, and they come back as soon as it is closed. -->
        <xpath expr="//div[hasclass('o_Chatter_scrollPanel')]" position="attributes">
            <attribute name="t-att-class">{ 'o-dwo-hiddenByEmail': chatter.dwoEmailOpen }</attribute>
        </xpath>
        <xpath expr="//div[hasclass('o_Chatter_fixedPanel')]" position="inside">
            <DwoEmailComposer t-if="chatter.dwoEmailOpen and chatter.thread"
                              thread="chatter.thread"
                              mode="chatter.dwoMode"
                              refMessageId="chatter.dwoRefMessageId"
                              preferredEmailId="chatter.dwoRememberedEmailId"
                              onEmailChange.bind="chatter.dwoOnEmailChange"
                              onClose.bind="chatter.dwoOnEmailClose"
                              onSent.bind="chatter.dwoOnEmailSent"
                              t-key="chatter.dwoKey"/>
        </xpath>
    </t>
</templates>
