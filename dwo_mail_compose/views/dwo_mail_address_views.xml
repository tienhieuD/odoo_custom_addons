<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="dwo_mail_address_view_list" model="ir.ui.view">
        <field name="name">dwo.mail.address.list</field>
        <field name="model">dwo.mail.address</field>
        <field name="arch" type="xml">
            <tree editable="bottom">
                <field name="email"/>
                <field name="name"/>
                <field name="use_count"/>
                <field name="last_used"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </tree>
        </field>
    </record>
    <record id="dwo_mail_address_view_search" model="ir.ui.view">
        <field name="name">dwo.mail.address.search</field>
        <field name="model">dwo.mail.address</field>
        <field name="arch" type="xml">
            <search>
                <field name="email"/>
                <field name="name"/>
            </search>
        </field>
    </record>
    <record id="dwo_mail_address_action" model="ir.actions.act_window">
        <field name="name">Email Address Book</field>
        <field name="res_model">dwo.mail.address</field>
        <field name="view_mode">tree</field>
    </record>
    <menuitem id="dwo_mail_address_menu"
              name="Email Address Book"
              parent="base.menu_email"
              action="dwo_mail_address_action"
              groups="base.group_system"
              sequence="90"/>
</odoo>
