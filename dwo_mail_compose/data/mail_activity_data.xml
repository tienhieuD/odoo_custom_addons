<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- One activity per approver. It is marked done as soon as the email is approved, rejected
         or sent directly by its author. -->
    <record id="mail_activity_type_email_approval" model="mail.activity.type">
        <field name="name">Email approval</field>
        <field name="icon">fa-envelope-o</field>
        <field name="res_model_id" ref="model_dwo_mail_email"/>
        <field name="delay_count">0</field>
        <field name="sequence">100</field>
    </record>
</odoo>
