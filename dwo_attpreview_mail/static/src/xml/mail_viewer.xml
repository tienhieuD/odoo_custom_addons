<templates xml:space="preserve">
    <t t-name="dwo_attpreview_mail.MailViewer">
        <div class="o_dwo_mail" t-att-data-kind="data.kind">
            <t t-if="isEmail">
                <div class="o_dwo_mail_head">
                    <h5 class="o_dwo_mail_subject" t-esc="data.subject or '(no subject)'"/>
                    <table class="o_dwo_mail_fields">
                        <tr t-foreach="fields" t-as="field" t-key="field[0]">
                            <th t-esc="field[0]"/>
                            <td t-esc="field[1]"/>
                        </tr>
                    </table>
                </div>
                <div t-if="remote.status === 'loading' or remote.status === 'loaded'" class="o_dwo_mail_blocked o_dwo_mail_proxied">
                    <i class="fa fa-shield me-1" aria-hidden="true"/>Remote pictures are loaded through your Odoo server: your IP address and browser are not shown to the sender.
                    <t t-if="remote.status === 'loading'"> Loading...</t>
                    <t t-elif="remote.failed"> <t t-esc="remote.failed"/> could not be loaded.</t>
                </div>
                <div t-elif="remote.status === 'blocked'" class="o_dwo_mail_blocked">
                    <i class="fa fa-shield me-1" aria-hidden="true"/>Remote pictures of this email are blocked to protect your privacy.
                    <button type="button" class="btn btn-link btn-sm p-0 ms-2 align-baseline o_dwo_mail_load_remote" t-on-click="() => this.loadRemote()">Load them through the server</button>
                </div>
                <div t-elif="data.remote_blocked" class="o_dwo_mail_blocked">
                    <i class="fa fa-shield me-1" aria-hidden="true"/>Remote content of this email is blocked to protect your privacy.
                </div>
                <div t-if="attachments.length" class="o_dwo_mail_atts">
                    <div t-foreach="attachments" t-as="att" t-key="att.index" class="o_dwo_mail_att">
                        <img class="o_dwo_mail_att_icon" t-att-src="iconOf(att)" alt=""/>
                        <button type="button" class="btn btn-link o_dwo_mail_att_name" t-att-title="'Preview ' + att.name"
                                t-att-disabled="!canOpenParts" t-on-click="() => this.onPreview(att)" t-esc="att.name"/>
                        <span class="o_dwo_mail_att_size" t-esc="sizeOf(att)"/>
                        <button type="button" class="btn btn-link o_dwo_mail_att_download" t-att-title="'Download ' + att.name"
                                aria-label="Download" t-att-disabled="!canOpenParts" t-on-click="() => this.onDownload(att)">
                            <i class="fa fa-download"/>
                        </button>
                    </div>
                </div>
                <iframe class="o_dwo_mail_body" title="Email body" sandbox="allow-popups allow-popups-to-escape-sandbox"
                        referrerpolicy="no-referrer" t-att-srcdoc="srcdoc"/>
            </t>
            <div t-elif="data.kind === 'calendar'" class="o_dwo_mail_cards">
                <div t-if="!data.events.length" class="alert alert-info">This file holds no event.</div>
                <div t-foreach="data.events" t-as="event" t-key="event_index" class="o_dwo_mail_card">
                    <div class="o_dwo_mail_card_top">
                        <i class="fa fa-calendar me-2" aria-hidden="true"/>
                        <h5 class="o_dwo_mail_card_title" t-esc="event.summary or '(no title)'"/>
                        <span t-if="methodLabel(data.method)" class="badge text-bg-secondary ms-2" t-esc="methodLabel(data.method)"/>
                        <span t-if="event.status === 'CANCELLED'" class="badge text-bg-danger ms-2">Cancelled</span>
                    </div>
                    <table class="o_dwo_mail_fields">
                        <tr t-if="event.start"><th>When</th><td><t t-esc="event.start"/><t t-if="event.end"> - <t t-esc="event.end"/></t></td></tr>
                        <tr t-if="event.recurrence"><th>Repeats</th><td t-esc="event.recurrence"/></tr>
                        <tr t-if="event.location"><th>Where</th><td t-esc="event.location"/></tr>
                        <tr t-if="event.organizer"><th>Organizer</th><td t-esc="event.organizer"/></tr>
                        <tr t-if="event.url and isWebLink(event.url)"><th>Link</th><td><a t-att-href="event.url" target="_blank" rel="noopener noreferrer" t-esc="event.url"/></td></tr>
                    </table>
                    <div t-if="event.attendees.length" class="o_dwo_mail_people">
                        <div class="o_dwo_mail_label">Attendees</div>
                        <div t-foreach="event.attendees" t-as="person" t-key="person_index" class="o_dwo_mail_person">
                            <span t-esc="person.name"/>
                            <span t-if="statusLabel(person.status)" class="o_dwo_mail_status" t-att-data-status="person.status" t-esc="statusLabel(person.status)"/>
                        </div>
                    </div>
                    <pre t-if="event.description" class="o_dwo_mail_note" t-esc="event.description"/>
                </div>
            </div>
            <div t-elif="data.kind === 'contacts'" class="o_dwo_mail_cards">
                <div t-if="!data.contacts.length" class="alert alert-info">This file holds no contact.</div>
                <div t-foreach="data.contacts" t-as="card" t-key="card_index" class="o_dwo_mail_card">
                    <div class="o_dwo_mail_card_top">
                        <i class="fa fa-user-circle me-2" aria-hidden="true"/>
                        <div>
                            <h5 class="o_dwo_mail_card_title" t-esc="card.name or '(no name)'"/>
                            <div t-if="card.title or card.organization" class="text-muted">
                                <t t-esc="card.title"/><t t-if="card.title and card.organization">, </t><t t-esc="card.organization"/>
                            </div>
                        </div>
                    </div>
                    <table class="o_dwo_mail_fields">
                        <tr t-foreach="card.emails" t-as="item" t-key="'e' + item_index"><th>Email<t t-if="item.type"> (<t t-esc="item.type"/>)</t></th><td><a t-att-href="'mailto:' + item.value" t-esc="item.value"/></td></tr>
                        <tr t-foreach="card.phones" t-as="item" t-key="'p' + item_index"><th>Phone<t t-if="item.type"> (<t t-esc="item.type"/>)</t></th><td t-esc="item.value"/></tr>
                        <tr t-foreach="card.addresses" t-as="item" t-key="'a' + item_index"><th>Address<t t-if="item.type"> (<t t-esc="item.type"/>)</t></th><td t-esc="item.value"/></tr>
                        <tr t-if="card.birthday"><th>Birthday</th><td t-esc="card.birthday"/></tr>
                        <tr t-if="card.url and isWebLink(card.url)"><th>Website</th><td><a t-att-href="card.url" target="_blank" rel="noopener noreferrer" t-esc="card.url"/></td></tr>
                    </table>
                    <pre t-if="card.note" class="o_dwo_mail_note" t-esc="card.note"/>
                </div>
            </div>
            <div t-else="" class="alert alert-info m-3">This file could not be displayed.</div>
        </div>
    </t>
</templates>
