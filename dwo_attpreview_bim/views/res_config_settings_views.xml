<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.dwo.attpreview.cad</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="dwo_attpreview_core.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//app[@name='dwo_attpreview_core']" position="inside">
                <block title="BIM size limits" name="dwo_attpreview_bim_size_block">
                    <setting id="dwo_attpreview_max_mb_bim_ifc" string="IFC building models" help="Larger files are not previewed. Applies to the file you open; a file inside another file is checked by its own type.">
                        <div class="mt8"><field name="dwo_attpreview_max_mb_bim_ifc"/> MB</div>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
