<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_dwo_approval_flow_list" model="ir.ui.view">
        <field name="name">dwo.approval.flow.list</field>
        <field name="model">dwo.approval.flow</field>
        <field name="arch" type="xml">
            <tree>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="model_id"/>
                <field name="state_mode"/>
                <field name="state_count"/>
                <field name="transition_count"/>
                <field name="company_id" groups="base.group_multi_company" optional="show"/>
                <field name="active" invisible="1"/>
            </tree>
        </field>
    </record>

    <record id="view_dwo_approval_flow_form" model="ir.ui.view">
        <field name="name">dwo.approval.flow.form</field>
        <field name="model">dwo.approval.flow</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_refresh_states" type="object" string="Refresh states" attrs="{'invisible': ['|', ('state_mode', '!=', 'field'), ('id', '=', False)]}"
                           />
                    <button name="action_test" type="object" string="Test" attrs="{'invisible': [('id', '=', False)]}"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="bg-danger" attrs="{'invisible': [('active', '!=', False)]}"/>
                    <field name="active" invisible="1"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. Purchase order approval"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="model_id" options="{'no_create': True, 'no_open': True}"/>
                            <field name="state_mode" widget="radio"/>
                            <field name="state_field_id"
                                  
                                   options="{'no_create': True, 'no_open': True}" attrs="{'invisible': [('state_mode', '!=', 'field')], 'required': [('state_mode', '=', 'field')]}"/>
                        </group>
                        <group>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="domain" widget="domain" options="{'model': 'model_name'}"/>
                            <field name="model_name" invisible="1"/>
                            <field name="replace_statusbar"/>
                            <field name="history_action"/>
                        </group>
                    </group>
                    <group string="Notifications" name="notify">
                        <group>
                            <field name="notify_template_id" options="{'no_create': True}"/>
                        </group>
                        <group>
                            <field name="remind_after"/>
                            <field name="remind_max" attrs="{'invisible': [('remind_after', '=', False)]}"/>
                        </group>
                    </group>
                    <field name="graph" widget="dwo_flow_designer" nolabel="1"
                           options="{'model_field': 'model_name'}" attrs="{'invisible': [('model_id', '=', False)]}"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_dwo_approval_test_form" model="ir.ui.view">
        <field name="name">dwo.approval.test.form</field>
        <field name="model">dwo.approval.test</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="flow_id" invisible="1"/>
                    <field name="res_model" invisible="1"/>
                    <field name="res_id" options="{'no_create': True}"/>
                    <field name="user_id" options="{'no_create': True}"/>
                </group>
                <field name="result" nolabel="1"/>
                <footer>
                    <button string="Close" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="view_dwo_approval_flow_search" model="ir.ui.view">
        <field name="name">dwo.approval.flow.search</field>
        <field name="model">dwo.approval.flow</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="model_id"/>
                <filter name="inactive" string="Archived" domain="[('active', '=', False)]"/>
                <group>
                    <filter name="by_model" string="Model" context="{'group_by': 'model_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_dwo_approval_flow" model="ir.actions.act_window">
        <field name="name">Approval Flows</field>
        <field name="res_model">dwo.approval.flow</field>
        <field name="view_mode">tree,form</field>
    </record>

    <record id="view_dwo_approval_log_list" model="ir.ui.view">
        <field name="name">dwo.approval.log.list</field>
        <field name="model">dwo.approval.log</field>
        <field name="arch" type="xml">
            <tree create="0" edit="0" delete="0">
                <field name="date"/>
                <field name="res_model"/>
                <field name="res_id"/>
                <field name="kind"/>
                <field name="button"/>
                <field name="from_name"/>
                <field name="to_name"/>
                <field name="user_id"/>
                <field name="votes"/>
                <field name="reason"/>
            </tree>
        </field>
    </record>

    <record id="action_dwo_approval_log" model="ir.actions.act_window">
        <field name="name">Approval Log</field>
        <field name="res_model">dwo.approval.log</field>
        <field name="view_mode">tree</field>
    </record>
</odoo>
