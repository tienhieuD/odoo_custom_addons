<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_dwo_approval_pending_list" model="ir.ui.view">
        <field name="name">dwo.approval.pending.list</field>
        <field name="model">dwo.approval.pending</field>
        <field name="arch" type="xml">
            <tree create="0" edit="0" action="action_open_document" type="object">
                <field name="record_name"/>
                <field name="res_model" optional="hide"/>
                <field name="flow_id"/>
                <field name="state_id"/>
                <field name="user_id" optional="show" groups="dwo_approval_flow.group_approval_manager"/>
                <field name="since"/>
                <field name="reminder_count" optional="hide"/>
            </tree>
        </field>
    </record>

    <record id="view_dwo_approval_pending_search" model="ir.ui.view">
        <field name="name">dwo.approval.pending.search</field>
        <field name="model">dwo.approval.pending</field>
        <field name="arch" type="xml">
            <search>
                <field name="record_name"/>
                <field name="flow_id"/>
                <field name="user_id"/>
                <filter name="mine" string="Waiting for me" domain="[('user_id', '=', uid)]"/>
                <group>
                    <filter name="by_flow" string="Flow" context="{'group_by': 'flow_id'}"/>
                    <filter name="by_user" string="Approver" context="{'group_by': 'user_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_dwo_approval_pending" model="ir.actions.act_window">
        <field name="name">Waiting for my approval</field>
        <field name="res_model">dwo.approval.pending</field>
        <field name="view_mode">tree</field>
        <field name="context">{'search_default_mine': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Nothing is waiting for you</p>
            <p>Documents show here when they enter a step you can approve, for the arrows set to notify the approvers.</p>
        </field>
    </record>

    <record id="view_dwo_approval_notify_log_list" model="ir.ui.view">
        <field name="name">dwo.approval.notify.log.list</field>
        <field name="model">dwo.approval.notify.log</field>
        <field name="arch" type="xml">
            <tree create="0" edit="0" delete="0" decoration-danger="not ok">
                <field name="date"/>
                <field name="record_name"/>
                <field name="user_id"/>
                <field name="kind"/>
                <field name="channel"/>
                <field name="ok"/>
                <field name="error"/>
                <field name="flow_id" optional="hide"/>
            </tree>
        </field>
    </record>

    <record id="view_dwo_approval_notify_log_search" model="ir.ui.view">
        <field name="name">dwo.approval.notify.log.search</field>
        <field name="model">dwo.approval.notify.log</field>
        <field name="arch" type="xml">
            <search>
                <field name="record_name"/>
                <field name="user_id"/>
                <filter name="failed" string="Failed" domain="[('ok', '=', False)]"/>
                <group>
                    <filter name="by_channel" string="Channel" context="{'group_by': 'channel'}"/>
                    <filter name="by_kind" string="Kind" context="{'group_by': 'kind'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_dwo_approval_notify_log" model="ir.actions.act_window">
        <field name="name">Notifications</field>
        <field name="res_model">dwo.approval.notify.log</field>
        <field name="view_mode">tree</field>
    </record>
</odoo>
