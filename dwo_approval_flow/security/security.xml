<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_approval_flow" model="ir.module.category">
        <field name="name">Approval Flow</field>
        <field name="sequence">26</field>
    </record>
    <record id="privilege_approval_flow" model="res.groups.privilege">
        <field name="name">Approval Flow</field>
        <field name="category_id" ref="module_category_approval_flow"/>
    </record>
    <record id="group_approval_manager" model="res.groups">
        <field name="name">Approval Flow / Administrator</field>
        <field name="privilege_id" ref="privilege_approval_flow"/>
    </record>
    <record id="base.group_system" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('group_approval_manager'))]"/>
    </record>

    <record id="rule_approval_flow_company" model="ir.rule">
        <field name="name">Approval flow: company</field>
        <field name="model_id" ref="model_dwo_approval_flow"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>

    <record id="rule_approval_pending_own" model="ir.rule">
        <field name="name">Waiting for approval: my own</field>
        <field name="model_id" ref="model_dwo_approval_pending"/>
        <field name="domain_force">[('user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
    </record>
    <record id="rule_approval_pending_manager" model="ir.rule">
        <field name="name">Waiting for approval: administrators see all</field>
        <field name="model_id" ref="model_dwo_approval_pending"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_approval_manager'))]"/>
    </record>
</odoo>
