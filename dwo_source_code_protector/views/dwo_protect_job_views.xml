<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_dwo_protect_job_list" model="ir.ui.view">
        <field name="name">dwo.protect.job.list</field>
        <field name="model">dwo.protect.job</field>
        <field name="arch" type="xml">
            <tree string="Source Code Protector — Jobs" create="false" edit="false">
                <field name="create_date" string="Started"/>
                <field name="name"/>
                <field name="state" widget="badge" decoration-success="state == 'done'" decoration-danger="state == 'error'" decoration-info="state in ('queued', 'running')"/>
                <field name="progress" widget="progressbar"/>
                <field name="progress_label" string="Step"/>
                <field name="module_count" string="Modules"/>
                <field name="python_version" string="Python" optional="show"/>
                <field name="zip_size_human" string="Size"/>
                <field name="is_expired" invisible="1"/>
                <field name="result_filename" invisible="1"/>
                <field name="result_file" filename="result_filename" widget="binary" string="Download" readonly="1"/>
            </tree>
        </field>
    </record>

    <record id="view_dwo_protect_job_form" model="ir.ui.view">
        <field name="name">dwo.protect.job.form</field>
        <field name="model">dwo.protect.job</field>
        <field name="arch" type="xml">
            <form string="Source Code Protector — Job" create="false" edit="false">
                <header>
                    <field name="state" widget="statusbar" statusbar_visible="queued,running,done"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>

                    <!-- Download la hanh dong chinh khi job xong, dat ngay dau, noi bat;
                         cac thong tin khac (zip, ngay gio, chi tiet ket qua) chi la phu, dua
                         xuong duoi. -->
                    <field name="is_expired" invisible="1"/>
                    <div class="alert alert-warning" role="alert" attrs="{'invisible': [('is_expired', '=', False)]}">
                        The uploaded and result files for this job have expired and were deleted.
                    </div>
                    <div class="o_horizontal_separator" attrs="{'invisible': ['|', ('state', '!=', 'done'), ('is_expired', '=', True)]}" style="background:#F0F6EF;border:1px solid #BFE3BC;border-radius:8px;padding:16px 20px;margin-bottom:16px">
                        <field name="result_filename" invisible="1"/>
                        <div style="font-size:1.15em;font-weight:600">
                            <field name="result_file" filename="result_filename" widget="binary" string="Download protected zip"/>
                        </div>
                        <div style="color:#4F5D55;font-size:0.9em;margin-top:6px">
                            Expires <field name="expires_at" nolabel="1" class="d-inline"/> (kept 1 day after the job finishes)
                        </div>
                    </div>

                    <group>
                        <group string="Progress" attrs="{'invisible': [('state', 'not in', ('queued', 'running'))]}">
                            <field name="progress" widget="progressbar"/>
                            <field name="progress_label" nolabel="1" colspan="2"/>
                            <field name="module_count" string="Modules found"/>
                            <field name="module_index" string="Modules done"/>
                        </group>
                        <group string="Zip" class="text-muted">
                            <field name="zip_size_human" string="Upload size"/>
                            <field name="python_version" string="Python version"/>
                            <field name="create_date" string="Queued at"/>
                            <field name="date_started"/>
                            <field name="date_done"/>
                        </group>
                    </group>
                    <!-- Khong de trong <group>: group gioi han chieu rong theo luoi 2-cot cua
                         Odoo, lam bang ket qua (mot HTML table that, tu result_info) bi co lai
                         rat hep va kho doc. Dung div thuong de no choan het chieu rong sheet. -->
                    <div attrs="{'invisible': [('state', '!=', 'done')]}" class="mt-3">
                        <h5 class="text-muted">Result</h5>
                        <field name="result_info" nolabel="1" widget="html"/>
                    </div>
                    <group string="Error" attrs="{'invisible': [('state', '!=', 'error')]}">
                        <field name="error_message" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_dwo_protect_job" model="ir.actions.act_window">
        <field name="name">Source Code Protector</field>
        <field name="res_model">dwo.protect.job</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No protection job yet</p>
            <p>Click "Protect a module zip" below to upload an Odoo module .zip and protect its source code.</p>
        </field>
    </record>

    <record id="action_dwo_protect_job_server_action" model="ir.actions.server">
        <field name="name">Protect a module zip</field>
        <field name="model_id" ref="model_dwo_protect_job"/>
        <field name="binding_model_id" ref="model_dwo_protect_job"/>
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code">action = {
    'type': 'ir.actions.act_window',
    'res_model': 'dwo.protect.source.wizard',
    'view_mode': 'form',
    'target': 'new',
}</field>
    </record>

    <!-- KHONG co menuitem rieng: man hinh nay chi vao duoc qua nut "View jobs" trong
         Settings > Source Code Protector (xem res_config_settings_views.xml), theo yeu cau
         chi de 1 muc duy nhat trong Settings, khong co menu ngoai. -->

</odoo>
