<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_dwo_protect_source_wizard_form" model="ir.ui.view">
        <field name="name">dwo.protect.source.wizard.form</field>
        <field name="model">dwo.protect.source.wizard</field>
        <field name="arch" type="xml">
            <form string="Source Code Protector">

                <!-- ── Step 1: choose ── -->
                <group invisible="state != 'choose'">
                    <div class="alert alert-info" role="alert" style="margin-bottom:12px">
                        <strong>How it works:</strong>
                        <ul style="margin:6px 0 0 0;padding-left:20px">
                            <li>Upload a <code>.zip</code> containing one or more Odoo modules. The <code>__manifest__.py</code> may sit at the zip root or inside a subfolder — both are detected automatically.</li>
                            <li>The tool extracts each module, protects its business logic, compiles it to native binaries, and returns a new zip named <code>&lt;original&gt;_compile.zip</code> keeping the exact same structure.</li>
                            <li>If your zip is password-protected, enter the password below — the protected output zip will be encrypted with the same password.</li>
                        </ul>
                    </div>
                    <div class="alert alert-warning" role="alert" style="margin-bottom:12px">
                        <strong>⚠ Platform notice:</strong> Compiled binaries (<code>.so</code>/<code>.pyd</code>) are <strong>platform-locked</strong>.
                        The protected module will only run on <strong>this Odoo server</strong>, or another server with the
                        <strong>same Python version, same OS, and same CPU architecture</strong>.
                        Always install and test the protected module on a <strong>staging</strong> database before production.
                    </div>
                    <group>
                        <field name="upload_file" filename="upload_filename" widget="binary" string="Module Zip"/>
                        <field name="upload_filename" invisible="1"/>
                        <field name="password" placeholder="Leave blank if zip is not encrypted"/>
                    </group>
                </group>

                <!-- ── Step 2: get ── -->
                <group invisible="state != 'get'">
                    <group string="Processing Result">
                        <field name="result_info" nolabel="1" widget="html"/>
                    </group>
                    <group string="Download">
                        <field name="output_file" filename="output_filename" widget="binary" string="Protected Zip" readonly="1"/>
                        <field name="output_filename" invisible="1"/>
                    </group>
                </group>

                <field name="state" invisible="1"/>

                <footer>
                    <button
                        name="action_protect"
                        string="Protect"
                        type="object"
                        class="btn-primary"
                        invisible="state != 'choose'"
                    />
                    <button
                        string="Close"
                        class="btn-secondary"
                        special="cancel"
                        invisible="state != 'get'"
                    />
                    <button
                        string="Cancel"
                        class="btn-secondary"
                        special="cancel"
                        invisible="state != 'choose'"
                    />
                </footer>
            </form>
        </field>
    </record>

    <record id="action_dwo_protect_source_wizard" model="ir.actions.act_window">
        <field name="name">Source Code Protector</field>
        <field name="res_model">dwo.protect.source.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem
        id="menu_dwo_protect_source_wizard"
        name="Source Code Protector"
        parent="base.menu_administration"
        action="action_dwo_protect_source_wizard"
        sequence="900"
    />

</odoo>
